---
import AreaHub from '../../components/AreaHub.astro';
import { getBristolAreas } from '../../lib/areas';

export function getStaticPaths() {
  return getBristolAreas().map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

const { area } = Astro.props;
---

<AreaHub area={area} />
