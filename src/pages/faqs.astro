---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';

const faqs = [
  { q: 'What’s the difference between plastering and rendering?', a: 'Plastering is for internal walls and ceilings — usually multi-finish plaster applied over plasterboard or bonding. Rendering is for external walls — a cement-based or silicone system designed to weatherproof the building. Different products, different trades in some respects, but we do both.' },
  { q: 'How long does plastering take to dry?', a: 'A 2-3mm skim coat typically takes 3-7 days to dry fully, depending on temperature, humidity and ventilation. We don’t recommend painting for at least 7 days after plastering — painting too early can cause the paint to flake. We provide an aftercare guide with every project explaining drying times for your specific conditions.' },
  { q: 'Can you plaster over Artex?', a: 'Yes, in most cases. We can either scrape back the high points of the Artex and skim over the top, or bond and skim over the whole ceiling for a perfectly flat modern finish. We can also remove Artex back to the original surface if needed. Note that some older Artex (pre-1980s) may contain asbestos — we can test and refer a specialist if needed.' },
  { q: 'Do you do airless spray plastering?', a: 'Yes — airless spray plastering is one of our specialities. It’s ideal for large projects (full house re-skims, new-builds, extensions) where the speed advantage really matters. A full 3-bed house can be plastered in 1-2 days with airless spray, compared with 4-6 days for hand trowel. The finish is slightly different (a fine stippled texture) but equally paint-ready.' },
  { q: 'Can I live in the house during plastering?', a: 'For most plastering jobs (single room, patching) yes, you can stay in the house. For full house re-skims we recommend finding alternative accommodation for 2-3 days while the plaster dries — there’s no smell but the work area needs to be kept warm and ventilated.' },
  { q: 'How much does rendering cost in Bristol?', a: 'It depends on the system, the size of the property and the condition of the existing walls. Silicone and monocouche cost more than sand-and-cement up front, but sand-and-cement needs painting every few years. We give fixed written quotes after a free site visit — never a figure over the phone.' },
  { q: 'How long does rendering take?', a: 'A typical 3-bed semi takes 5-7 working days from scaffold erection to final coat. Detached homes and larger properties take 7-14 days. EWI installations take 2-4 weeks.' },
  { q: 'Do I need planning permission for rendering or EWI?', a: 'For most Bristol and Bath homes, no — rendering and EWI are permitted development. Exceptions include listed buildings, properties in conservation areas with specific Article 4 restrictions, and some post-2020 new-builds. We’ll advise at the site visit.' },
  { q: 'What render system should I choose?', a: 'It depends on your substrate, budget and the look you want. Silicone is the most popular modern system — self-cleaning, water-repellent, 25+ year lifespan. Monocouche is slightly cheaper and gives a more traditional mineral finish. Acrylic is cost-effective for over-coats. We’ll recommend the right one at your free site visit.' },
  { q: 'Can you render over pebbledash?', a: 'Yes. We typically scrape off loose stones, key the surface, then apply a base coat before the chosen topcoat. For very thick or well-bonded pebbledash we may apply a mesh-reinforced base coat directly over.' },
  { q: 'What’s the difference between bonding plaster and skim?', a: 'Bonding plaster is the base coat applied to bare brick or blockwork — typically 8-15mm thick. Skim plaster is the final 2-3mm coat applied over bonding (or over plasterboard) to give a smooth paint-ready finish. Most plastering jobs use both.' },
  { q: 'What warranty do you offer?', a: 'It depends on the service. Rendering and external wall insulation come with a 10-year workmanship warranty as standard, plus the relevant manufacturer system warranty (typically 25 years for silicone, monocouche and EWI) where installations meet spec. Internal plastering carries a 5-year workmanship warranty. Your quote will state which applies.' },
  { q: 'Are you insured?', a: 'Yes. We carry full public liability insurance and employer’s liability cover. Documentation available on request.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<PageLayout
  title="FAQs | KD Plastering & Rendering Services"
  description="Common questions about plastering, rendering and external wall insulation in Bristol and Bath. Cost, time, materials, planning permission and more."
  preloadImage="/heroes/faqs.webp"
  canonical="/faqs/"
  schema={faqSchema}
  breadcrumbs={[{ name: 'FAQs', href: '/faqs/' }]}
  ctaHeading="Got a question we haven't answered?"
  ctaText="Call us on 0117 409 4116 or send a message and we'll get back to you the same day."
  ctaLabel="Get in touch"
>
  <Hero
    size="compact"
    eyebrow={['FAQs']}
    title="Frequently asked"
    titleAccent="questions."
    lede="Common questions about plastering, rendering and external wall insulation in Bristol and Bath."
    primaryCta={{ label: 'Ask us directly', href: '/contact/#lead-form-heading' }}
    phone={{ number: '+441174094116', display: '0117 409 4116' }}
    image="/heroes/faqs.webp"
    imageAlt=""
  />

  <section class="section">
    <div class="container container--reading">
      <div class="faq-section">
        {faqs.map(f => (
          <details>
            <summary>{f.q}</summary>
            <div class="faq-answer">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
