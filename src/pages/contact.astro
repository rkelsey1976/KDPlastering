---
import PageLayout from '../layouts/PageLayout.astro';
import { PROFILES, COMPANY } from '../lib/contact';
import Hero from '../components/Hero.astro';
import { getBristolAreas, getBathAreas } from '../lib/areas';
import AreaCoverage from '../components/AreaCoverage.astro';
import LeadForm from '../components/LeadForm.astro';

const bristol = getBristolAreas();
const bath = getBathAreas();

// Single source of truth for NAP — must match the homepage schema and the
// Google Business Profile exactly, or local ranking signals get diluted.
const nap = {
  name: 'KD Plastering & Rendering Services',
  street: '8 Roman Way, Hanham',
  locality: 'Bristol',
  postcode: 'BS15 3FH',
  phoneDisplay: '0117 409 4116',
  phoneHref: '+441174094116',
  email: 'kdplasteringltd@gmail.com',
  // From the Google Business Profile. The previous values were 655m out.
  lat: 51.4427857,
  lng: -2.5122453,
};

const hours = [
  { days: 'Monday – Friday', time: '8am – 6pm' },
  { days: 'Saturday',        time: '9am – 1pm' },
  { days: 'Sunday',          time: 'Closed' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'Plasterer'],
  '@id': 'https://www.kdplasteringrenderingservices.co.uk/#organization',
  name: nap.name,
  url: 'https://www.kdplasteringrenderingservices.co.uk/contact/',
  telephone: `+${nap.phoneHref.replace('+', '')}`,
  contactPoint: [
    { '@type': 'ContactPoint', telephone: '+441174094116', contactType: 'customer service', areaServed: 'GB', availableLanguage: 'English' },
    { '@type': 'ContactPoint', telephone: '+447961114662', contactType: 'customer service', areaServed: 'GB', availableLanguage: 'English' },
  ],
  // Consolidates this site with the same business elsewhere.
  sameAs: PROFILES,
  // The registered entity behind the trading name (Companies House 10957221).
  legalName: COMPANY.legalName,
  foundingDate: COMPANY.incorporated,
  identifier: {
    '@type': 'PropertyValue',
    name: 'Company number',
    value: COMPANY.number,
  },
    email: nap.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: nap.street,
    addressLocality: nap.locality,
    postalCode: nap.postcode,
    addressCountry: 'GB',
  },
  geo: { '@type': 'GeoCoordinates', latitude: nap.lat, longitude: nap.lng },
  areaServed: [...bristol, ...bath].map((a) => ({ '@type': 'Place', name: a.name })),
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '18:00',
    },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '13:00' },
  ],
  priceRange: '££',
};

const mapQuery = encodeURIComponent(`${nap.street}, ${nap.locality} ${nap.postcode}`);
---

<PageLayout
  title="Contact KD Plastering & Rendering Services | Bristol & Bath"
  description="Get a free quote from KD Plastering & Rendering Services. Call 0117 409 4116, email us, or send the form. Based in Hanham, Bristol — covering Bristol and Bath."
  preloadImage="/heroes/contact.webp"
  canonical="/contact/"
  schema={schema}
  breadcrumbs={[{ name: 'Contact', href: '/contact/' }]}
  showLeadForm={false}
  showCta={false}
>
  <Hero
    size="compact"
    eyebrow={['Contact']}
    title="Tell us about"
    titleAccent="the property."
    lede="We'll come and look at it. Free site visit across Bristol and Bath, a fixed written quote within 48 hours, and no pressure either way."
    primaryCta={{ label: 'Send us the details', href: '#lead-form-heading' }}
    phone={{ number: '01174094116', display: '0117 409 4116' }}
    image="/heroes/contact.webp"
    imageAlt=""
    trust={['Free site visit', 'Fixed written quote', 'Within 48 hours']}
  />

  <section class="section">
    <div class="container">
      <div class="contact-layout">
        <div class="contact-layout__main">
          <h2 id="lead-form-heading" class="contact-form-heading">Get your free quote</h2>
          <p class="lede">
            Tell us about the property and we'll come and look at it — free site visit,
            fixed written quote within 48 hours.
          </p>
          <LeadForm />
        </div>

        <aside class="contact-aside" aria-label="Contact details">
          <div class="contact-aside__block">
            <h3>Call or email</h3>
            <a href={`tel:${nap.phoneHref}`} class="contact-aside__phone">{nap.phoneDisplay}</a>
            <a href={`mailto:${nap.email}`} class="contact-aside__email">{nap.email}</a>
          </div>

          <div class="contact-aside__block">
            <h3>Where we are</h3>
            <address class="contact-aside__address">
              {nap.street}<br />
              {nap.locality} {nap.postcode}
            </address>
            <p class="contact-aside__note">Based in Hanham — covering Bristol and Bath.</p>
          </div>

          <div class="contact-aside__block">
            <h3>Opening hours</h3>
            <dl class="contact-aside__hours">
              {hours.map((h) => (
                <>
                  <dt>{h.days}</dt>
                  <dd>{h.time}</dd>
                </>
              ))}
            </dl>
          </div>

          <ul class="contact-aside__trust">
            <li>10+ years in Bristol</li>
            <li>Fully insured</li>
            <li>Free site visits</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Find us</h2>
      <p class="lede">8 Roman Way, Hanham, Bristol BS15 3FH.</p>

      {/* Click-to-load: nothing is requested from Google until someone asks
          for the map, so the site really does load no third-party scripts by
          default — which is what the cookie policy says. */}
      <div class="map" data-map-src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}>
        <div class="map__facade">
          <p class="map__title">View the map</p>
          <p class="map__note">
            Loads Google Maps, which sets cookies. Nothing is requested until you choose to load it.
          </p>
          <button type="button" class="map__load btn btn--primary">Load map</button>
          <p class="map__alt">
            <a href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} target="_blank" rel="noopener noreferrer">
              Or open directions in a new tab
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
        <AreaCoverage
          eyebrow="Coverage"
          heading="Areas we cover"
          lede="Twenty neighbourhoods across Bristol and Bath. Not listed? Ask — we travel."
        />
    </div>
  </section>
</PageLayout>

<script>
  // Swap the facade for the real iframe only on click.
  document.querySelectorAll<HTMLElement>('.map').forEach((wrap) => {
    wrap.querySelector('.map__load')?.addEventListener('click', () => {
      const src = wrap.dataset.mapSrc;
      if (!src) return;
      const frame = document.createElement('iframe');
      frame.src = src;
      frame.title = 'Map showing 8 Roman Way, Hanham, Bristol BS15 3FH';
      frame.loading = 'lazy';
      frame.referrerPolicy = 'no-referrer-when-downgrade';
      frame.setAttribute('allowfullscreen', '');
      wrap.replaceChildren(frame);
    });
  });
</script>

<style>
  /* Form first and widest — it is the reason the page exists. Details sit
     alongside as a reference column rather than above the ask. */
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(260px, 1fr);
    gap: var(--sp-7);
    align-items: start;
  }
  .contact-form-heading { margin: 0 0 var(--sp-3); }
  .contact-layout__main .lede { margin-bottom: var(--sp-5); }

  .contact-aside {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    padding: var(--sp-5);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    /* stays in view while a long form is filled in */
    position: sticky;
    top: calc(var(--header-h, 72px) + var(--sp-4));
  }
  .contact-aside__block + .contact-aside__block {
    padding-top: var(--sp-5);
    border-top: 1px solid var(--border);
  }
  .contact-aside h3 {
    margin: 0 0 var(--sp-3);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--text-muted);
  }

  .contact-aside__phone {
    display: block;
    font-size: var(--fs-lg);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-heading);
    font-variant-numeric: tabular-nums;
    color: var(--text);
    text-decoration: none;
  }
  .contact-aside__phone:hover { color: var(--accent-text); }
  .contact-aside__email {
    display: block;
    margin-top: var(--sp-2);
    font-size: var(--fs-sm);
    word-break: break-word;
  }

  .contact-aside__address {
    font-style: normal;
    line-height: 1.6;
    margin: 0;
    color: var(--text-secondary);
  }
  .contact-aside__note {
    margin: var(--sp-2) 0 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .contact-aside__hours {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--sp-2) var(--sp-4);
    margin: 0;
  }
  .contact-aside__hours dt { font-size: var(--fs-sm); color: var(--text-muted); }
  .contact-aside__hours dd {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--weight-semi);
    font-variant-numeric: tabular-nums;
  }

  .contact-aside__trust {
    list-style: none;
    margin: 0;
    padding: var(--sp-5) 0 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .contact-aside__trust li {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--text-secondary);
  }
  .contact-aside__trust li::before {
    content: '';
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (max-width: 900px) {
    .contact-layout { grid-template-columns: 1fr; gap: var(--sp-6); }
    /* sticky is pointless once it is stacked below the form */
    .contact-aside { position: static; }
  }





  .map {
    margin-top: var(--sp-6);
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface-sunken);
  }
  .map :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .map__facade {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
    text-align: center;
    padding: var(--sp-6);
  }
  .map__title { margin: 0; font-size: var(--fs-lg); font-weight: var(--weight-bold); }
  .map__note { margin: 0; max-width: 46ch; font-size: var(--fs-sm); color: var(--text-muted); }
  .map__alt { margin: 0; font-size: var(--fs-sm); }

  @media (max-width: 640px) {
  }
</style>
