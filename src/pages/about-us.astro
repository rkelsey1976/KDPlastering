---
import PageLayout from '../layouts/PageLayout.astro';
import AuthorityBio from '../components/AuthorityBio.astro';
import AreaCoverage from '../components/AreaCoverage.astro';
import ServiceBullets from '../components/ServiceBullets.astro';
import Hero from '../components/Hero.astro';

const whatWeDo = [
  'Internal plastering — boarding, skimming, Artex removal, patch plastering, screeding',
  'External rendering — silicone, monocouche, acrylic, sand-and-cement',
  'External wall insulation (EWI) — BBA-approved systems with 25-year manufacturer warranty',
  'Pebbledash removal and re-rendering',
  'Heritage and lime-render work',
  'Commercial rendering',
];

const accreditations = [
  'Checkatrade approved, rated 9.8/10 from 194 reviews',
  'TrustATrader member',
  "£10m public liability insurance, plus employer's liability cover",
  "Johnstone's, Parex, K Rend and Weber approved installer",
  'BBA-approved system specifications',
  '10-year workmanship warranty; up to 25-year insurance-backed on qualifying systems',
];
---

<PageLayout
  title="About Us | KD Plastering & Rendering Services"
  description="Bristol-based plastering, rendering and external wall insulation specialists. 15 years on the tools, £10m public liability insurance, 4.9 on Google."
  preloadImage="/heroes/about-us.webp"
  canonical="/about-us/"
  breadcrumbs={[{ name: 'About Us', href: '/about-us/' }]}
  ctaHeading="Get a free quote for your project"
  ctaText="Free site visit, fixed written quote, no pressure."
>
  <Hero
    size="compact"
    eyebrow={['About us', 'Since 2014']}
    title="Bristol plastering and rendering,"
    titleAccent="done properly."
    lede="A well established Bristol plastering and rendering business, covering Bath and all surrounding areas."
    primaryCta={{ label: 'Get a Free Quote', href: '/contact/#lead-form-heading' }}
    phone={{ number: '+441174094116', display: '0117 409 4116' }}
    image="/heroes/about-us.webp"
    imageAlt=""
    trust={['15 years in the trade', '4.9 on Google', '£10m public liability']}
  />

  <!-- Who we are -->
  <section class="section">
    <div class="container">
      <div class="media-split">
        <div class="media-split__copy">
          <p>
            KD Plastering &amp; Rendering Services is a well established business in the
            heart of Bristol, covering Bath and all surrounding areas. We are specialists
            in every type of plastering, rendering and external wall insulation, with
            fifteen years of trade experience.
          </p>
          <p>
            We are a small team by choice. Four full-time installers, every project led
            personally by the founder, and no subcontracting — which is why the person who
            quotes your job is the person who turns up to do it.
          </p>
        </div>
        <figure class="media-split__media">
          <img
            src="/services/gallery/ewall-rendering-1.webp"
            alt="KD Plastering applying sprayed cream monocouche render to a house exterior"
            width="920" height="613" loading="lazy" decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- Founder -->
  <section class="section section--alt">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">The team</span>
        <h2>Who runs KD Plastering</h2>
      </header>
      <AuthorityBio
        name="Kyran"
        role="Founder & Lead Installer"
        qualifications={[
          'NVQ Level 3 in Plastering',
          "Johnstone's Stormshield Registered Installer",
          'Parex Approved Applicator',
          'Weber EWI Certified Installer',
          "15 years' plastering and rendering experience across Bristol & Bath",
        ]}
        bio={`Kyran Dyer founded KD Plastering & Rendering Services in 2014, after several years working for larger Bristol contractors. Based in Hanham, he leads every project personally and is on site for the key stages of every installation. Kyran specifies every quote himself and oversees the team of four full-time installers. He holds NVQ Level 3 in Plastering and certified installer status with Johnstone's, Parex and Weber.`}
      />
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container">
      <ServiceBullets
        items={whatWeDo}
        variant="do"
        columns={3}
        eyebrow="What we do"
        heading="Every type of plastering and rendering"
        lede="We work for homeowners, landlords and developers across the BS and BA postcode areas."
      />
    </div>
  </section>

  <!-- How we work -->
  <section class="section section--alt">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">How we work</span>
        <h2>Fixed quotes, no surprises</h2>
      </header>
      <div class="media-split media-split--reverse">
        <div class="media-split__copy">
          <p>
            Every quote is free, written and fixed. We come and look at the property, take
            measurements, and price the job properly — so the number you get is the number
            you pay.
          </p>
          <p>
            We use only BBA-accredited systems from Johnstone's, Parex, K Rend and Weber.
            Every installation carries a 10-year workmanship warranty as standard, plus the
            relevant manufacturer system warranty — typically 25 years for silicone and EWI.
          </p>
        </div>
        <figure class="media-split__media">
          <img
            src="/services/gallery/ewall-rendering-2.webp"
            alt="Close-up of a steel trowel smoothing cream render"
            width="920" height="613" loading="lazy" decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- Accreditations -->
  <section class="section">
    <div class="container">
      <ServiceBullets
        items={accreditations}
        variant="benefit"
        columns={3}
        eyebrow="Credentials"
        heading="Accreditations and cover"
        lede="Every claim on this page is one you can check."
      />
    </div>
  </section>

  <!-- Coverage -->
  <section class="section section--alt">
    <div class="container">
      <AreaCoverage
        eyebrow="Coverage"
        heading="Where we work"
        lede="Based in Hanham (Bristol BS15), covering 23 neighbourhoods across Bristol and Bath."
        note="Each service page lists the full coverage for your area. Outside it? Ask — we travel."
      />
    </div>
  </section>
</PageLayout>
