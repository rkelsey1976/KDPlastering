---
import PageLayout from '../../../layouts/PageLayout.astro';
import Hero from '../../../components/Hero.astro';
import ServiceBullets from '../../../components/ServiceBullets.astro';
import ReviewCards from '../../../components/ReviewCards.astro';
import { getBathAreas, getArea } from '../../../lib/areas';
import { SERVICES, serviceHook, warrantyBadge } from '../../../lib/services';
import { REVIEWS, reviewsFor } from '../../../lib/reviews';
import { SERVICE_GALLERY } from '../../../lib/serviceGallery';

// service × neighbourhood, Bath only: 6 services × every Bath area.
// Mirrors the Bristol [area].astro so the two silos feel like one site.
// The per-page differentiation is the same: the area's own housing stock,
// access, landmarks, pricing note and nearby projects, plus this service's
// problems — all two-axis, none invented.
export function getStaticPaths() {
  const areas = getBathAreas();
  return SERVICES.flatMap((service) =>
    areas.map((area) => ({
      params: { service: service.slug, area: area.slug },
      props: { service, area },
    }))
  );
}

const { service, area } = Astro.props;

const prose = service.shortName.replace(/\s+Services$/i, '');
const proseLower = prose.toLowerCase();

// Projects in this area that match this service — the one block that varies
// on both axes.
const KEYWORDS: Record<string, string[]> = {
  'silicone-rendering':       ['silicone'],
  'monocouche-rendering':     ['monocouche'],
  'external-wall-insulation': ['ewi', 'insulation'],
  'house-rendering':          ['re-render', 'full re-render', 'render on'],
  'external-wall-rendering':  ['render', 'lime render', 'elevation'],
  'plastering-services':      ['plaster', 'skim', 'artex'],
};
const keys = KEYWORDS[service.slug] ?? [];
const matched = area.nearbyProjects.filter((p: string) =>
  keys.some((k) => p.toLowerCase().includes(k))
);

// Reviews for this area, then this service, then any heritage / lime work
// (the claim these Bath pages rest on), then city-wide — labelled honestly.
const areaReviews = REVIEWS.filter((r) => r.area === area.name);
const exact = areaReviews.filter((r) => r.service.toLowerCase().includes(proseLower));
const heritage = REVIEWS.filter((r) => r.heritage);
const reviews = exact.length
  ? exact
  : areaReviews.length
    ? areaReviews
    : heritage.length
      ? heritage.slice(0, 3)
      : reviewsFor(`${service.slug}-${area.slug}`);
const reviewScope = exact.length
  ? `${prose} in ${area.name}`
  : areaReviews.length
    ? area.name
    : heritage.length
      ? 'heritage & listed'
      : 'Bristol & Bath';

const otherServices = SERVICES.filter((s) => s.slug !== service.slug);

// Capped at two, same as the Bristol pages — a route back up matters more
// than a wide spread sideways through the weakest tier.
const nearby = area.nearbyAreas
  .map((s: string) => getArea(s))
  .filter((a): a is NonNullable<typeof a> => Boolean(a) && a!.city === 'bath')
  .slice(0, 2);

const bathAreaCount = getBathAreas().length;

// Recent-work photos for this service. Same set the service hubs use — a
// supporting strip here, capped so it doesn't take over a two-axis page.
const gallery = (SERVICE_GALLERY[service.slug] ?? []).slice(0, 3);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${prose} in ${area.name}, Bath`,
  serviceType: prose,
  provider: {
    '@type': 'LocalBusiness',
    '@id': 'https://www.kdplasteringrenderingservices.co.uk/#organization',
    name: 'KD Plastering & Rendering Services',
    telephone: '+441174094116',
  },
  areaServed: {
    '@type': 'Place',
    name: `${area.name}, Bath`,
    address: { '@type': 'PostalAddress', addressLocality: area.name, postalCode: area.postcode, addressCountry: 'GB' },
  },
};
---

<PageLayout
  title={`${prose} in ${area.name} ${area.postcode} | ${serviceHook(service)}`}
  description={`${prose} in ${area.name}, Bath ${area.postcode}. Georgian and listed work, lime-compatible systems, a free site visit and a fixed written quote within 48 hours.`}
  preloadImage={`/heroes/${service.slug}.webp`}
  canonical={`/our-services/${service.slug}-bath/${area.slug}/`}
  schema={schema}
  breadcrumbs={[
    { name: 'Our Services', href: '/our-services/' },
    { name: service.shortName, href: `/our-services/${service.slug}-bristol/` },
    { name: 'Bath', href: `/our-services/${service.slug}-bath/` },
    { name: area.name, href: `/our-services/${service.slug}-bath/${area.slug}/` },
  ]}
  ctaHeading={`${prose} in ${area.name}?`}
  ctaText={`Free site visit across ${area.name} ${area.postcode}, a fixed written quote within 48 hours, and a straight answer on whether consent is needed.`}
>
  <Hero
    size="compact"
    eyebrow={[`${area.name} · ${area.postcode}`, prose]}
    title={`${prose} in`}
    titleAccent={area.name}
    lede={area.intro}
    primaryCta={{ label: 'Get a Free Quote', href: '/contact/#lead-form-heading' }}
    phone={{ number: '+441174094116', display: '0117 409 4116' }}
    image={`/heroes/${service.slug}.webp`}
    imageAlt=""
    trust={['Free site visit', 'Fixed written quote', warrantyBadge(service)]}
  />

  <!-- Area context, framed for Bath rather than reused from the Bristol copy -->
  <section class="section">
    <div class="container">
      <div class="media-split">
        <div class="media-split__copy">
          <p class="sxa-note">
            Most {proseLower} work in {area.name} sits on Georgian limestone rather than
            the brick and pebbledash that dominates Bristol. That changes the
            specification before it changes the price — a solid lime-built wall
            needs a breathable system, and listed or conservation-area status is
            common here. We survey every property before quoting and say plainly
            whether {proseLower} is the right answer for your wall.
          </p>
          <p class="sxa-lead">{area.longIntro}</p>
        </div>
        <figure class="media-split__media">
          <img
            src={`/services/cards/${service.slug === 'external-wall-rendering' ? 'ewall-rendering' : service.slug === 'external-wall-insulation' ? 'ewi' : service.slug === 'plastering-services' ? 'plastering' : service.slug}.webp`}
            alt=""
            width="760" height="475" loading="lazy" decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- Projects matching this service in this area -->
  {matched.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <header class="section-header section-header--center">
          <span class="eyebrow">Recent work</span>
          <h2>{prose} we've done in {area.name}</h2>
        </header>
        <ul class="sxa-projects">
          {matched.map((p: string) => <li>{p}</li>)}
        </ul>
      </div>
    </section>
  )}

  <!-- What this service actually solves -->
  <section class="section section--alt">
    <div class="container">
      <ServiceBullets
        items={service.problems}
        variant="problem"
        columns={2}
        eyebrow="Problems we fix"
        heading={`When ${area.name} homeowners call us about ${proseLower}`}
        lede="If any of these sound like your property, this is the service you want."
      />
    </div>
  </section>

  <!-- Housing stock for this area -->
  <section class="section">
    <div class="container">
      <ServiceBullets
        items={area.propertyTypes}
        variant="do"
        columns={3}
        eyebrow="Housing stock"
        heading={`${area.name} properties we ${proseLower.includes("plaster") ? "plaster" : "render"}`}
        lede={`What ${proseLower} typically involves on the housing stock here.`}
      />
    </div>
  </section>

  {gallery.length > 0 && (
    <section class="section">
      <div class="container">
        <header class="section-header section-header--center">
          <span class="eyebrow">Recent work</span>
          <h2>{prose} we have done</h2>
          <p class="lede">Real jobs across Bristol and Bath, photographed as we finished them.</p>
        </header>
        <ul class="sxa-gallery">
          {gallery.map((img) => (
            <li>
              <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
        <p class="sxa-gallery__more">
          <a href="/our-work/">More {proseLower} projects in the gallery</a>
        </p>
      </div>
    </section>
  )}

  <!-- Local knowledge -->
  <section class="section section--alt">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Local knowledge</span>
        <h2>Working in {area.name}</h2>
      </header>
      <div class="sxa-facts">
        <div class="sxa-fact">
          <h3>Access &amp; parking</h3>
          <p>{area.transport}</p>
        </div>
        <div class="sxa-fact">
          <h3>Who lives here</h3>
          <p>{area.demographics}</p>
        </div>
        <div class="sxa-fact">
          <h3>Landmarks we work around</h3>
          <ul class="sxa-chips">{area.landmarks.map((l: string) => <li>{l}</li>)}</ul>
        </div>
        <div class="sxa-fact">
          <h3>Pricing &amp; consent</h3>
          <p>{area.costVariation}</p>
        </div>
      </div>
    </div>
  </section>

  <ReviewCards
    reviews={reviews}
    eyebrow="Reviews"
    heading={`What ${reviewScope} customers say`}
    lede="Verified reviews from recent work."
  />

  <!-- Cross-links: other services here, and this service nearby -->
  <section class="section section--alt">
    <div class="container">
      <div class="sxa-links">
        <div>
          <h3 class="sxa-links__title">Other services in {area.name}</h3>
          <ul class="sxa-links__list">
            {otherServices.map((s) => (
              <li>
                <a href={`/our-services/${s.slug}-bath/${area.slug}/`}>
                  {s.shortName.replace(/\s+Services$/i, '')} in {area.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="sxa-links__title">{prose} nearby</h3>
          <ul class="sxa-links__list">
            {nearby.map((a) => (
              <li>
                <a href={`/our-services/${service.slug}-bath/${a.slug}/`}>
                  {prose} in {a.name} <span>{a.postcode}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p class="sxa-faq">Questions about {proseLower}? See the <a href="/faqs/">FAQs</a>.</p>

      <ul class="sxa-up">
        <li>
          <a href={`/our-services/${service.slug}-bath/`}>
            <span class="sxa-up__label">All {proseLower} in Bath</span>
            <span class="sxa-up__sub">All {bathAreaCount} Bath neighbourhoods</span>
          </a>
        </li>
        <li>
          <a href={`/bath/${area.slug}/`}>
            <span class="sxa-up__label">Plastering &amp; rendering in {area.name}</span>
            <span class="sxa-up__sub">All six services, {area.postcode}</span>
          </a>
        </li>
        <li>
          <a href="/bath/">
            <span class="sxa-up__label">Bath coverage</span>
            <span class="sxa-up__sub">{bathAreaCount} neighbourhoods</span>
          </a>
        </li>
        <li>
          <a href={`/our-services/${service.slug}-bristol/`}>
            <span class="sxa-up__label">{prose} in Bristol</span>
            <span class="sxa-up__sub">Where most of our work is</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</PageLayout>

<style>
  .sxa-up {
    list-style: none;
    margin: var(--sp-6) 0 0;
    padding: var(--sp-5) 0 0;
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--sp-3);
  }
  .sxa-up a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    height: 100%;
    padding: var(--sp-4);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .sxa-up a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .sxa-up__label { font-weight: var(--weight-semi); color: var(--text); font-size: var(--fs-sm); }
  .sxa-up__sub { font-size: var(--fs-xs); color: var(--text-muted); }

  .sxa-note {
    margin: 0 0 var(--sp-5);
    padding-left: var(--sp-5);
    border-left: 3px solid var(--accent);
    font-size: var(--fs-md);
    line-height: 1.7;
    color: var(--text);
  }
  .sxa-lead { font-size: var(--fs-md); line-height: 1.75; color: var(--text-secondary); }

  .sxa-faq {
    margin: var(--sp-5) 0 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  .sxa-faq a { color: var(--accent-text); font-weight: var(--weight-semi); }

  .sxa-gallery {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--sp-3);
    max-width: var(--container-narrow);
  }
  .sxa-gallery li { margin: 0; }
  .sxa-gallery img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-md);
    background: var(--surface-sunken);
  }
  .sxa-gallery__more {
    text-align: center;
    margin: var(--sp-4) 0 0;
    font-size: var(--fs-sm);
  }
  .sxa-gallery__more a { color: var(--accent-text); font-weight: var(--weight-semi); }

  .sxa-projects {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--sp-3);
    max-width: var(--container-narrow);
  }
  .sxa-projects li {
    position: relative;
    padding: var(--sp-4) var(--sp-4) var(--sp-4) var(--sp-6);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--text-secondary);
  }
  .sxa-projects li::before {
    content: '';
    position: absolute;
    left: var(--sp-4);
    top: 1.35em;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .sxa-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: var(--sp-4);
  }
  .sxa-fact {
    padding: var(--sp-5);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .sxa-fact h3 {
    margin: 0 0 var(--sp-3);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--text-muted);
  }
  .sxa-fact p { margin: 0; font-size: var(--fs-sm); line-height: 1.6; color: var(--text-secondary); }
  .sxa-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .sxa-chips li {
    padding: var(--sp-1) var(--sp-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: var(--fs-xs);
    color: var(--text-secondary);
  }

  .sxa-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--sp-6);
  }
  .sxa-links__title {
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--text-muted);
  }
  .sxa-links__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--sp-2); }
  .sxa-links__list a {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-4);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: var(--fs-sm);
    text-decoration: none;
    color: var(--text);
    transition: border-color var(--dur-fast) var(--ease);
  }
  .sxa-links__list a:hover { border-color: var(--accent); color: var(--accent-text); }
  .sxa-links__list span {
    font-size: var(--fs-xs);
    font-weight: var(--weight-bold);
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
  }
</style>
