---
import PageLayout from '../../../layouts/PageLayout.astro';
import Hero from '../../../components/Hero.astro';
import ServiceBullets from '../../../components/ServiceBullets.astro';
import ProblemList from '../../../components/ProblemList.astro';
import BenefitGrid from '../../../components/BenefitGrid.astro';
import ProcessTimeline from '../../../components/ProcessTimeline.astro';
import MaterialGrid from '../../../components/MaterialGrid.astro';
import ReviewCards from '../../../components/ReviewCards.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import AuthorityBio from '../../../components/AuthorityBio.astro';
import AreaCoverage from '../../../components/AreaCoverage.astro';
import { SERVICES, serviceHook, warrantyBadge, getRelatedServices, getTagline } from '../../../lib/services';
import { getBathAreas, getBristolAreas } from '../../../lib/areas';
import { REVIEWS } from '../../../lib/reviews';
import { getBathNote } from '../../../lib/bathServiceNotes';
import { SERVICE_GALLERY } from '../../../lib/serviceGallery';
import { getCollection } from 'astro:content';

const bristolAreaCount = getBristolAreas().length;

// Bath service pages. They open with what genuinely differs — Georgian
// limestone, listed and conservation constraints, the pricing that follows
// — then run the same spec sections as the Bristol hub so the two cities
// feel like one site. The Bath areas, constraints, reviews and coverage
// keep each page distinct.
export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const prose = service.shortName.replace(/\s+Services$/i, '');
const proseLower = prose.toLowerCase();

const areas = getBathAreas();
const note = getBathNote(service.slug);
const gallery = SERVICE_GALLERY[service.slug] ?? [];

// Related services, taglines swapped to the Bath wording, cards pointed at
// the Bath hubs so the link equity stays in this silo.
const relatedServices = getRelatedServices(service.slug).map((s) => ({
  slug: s.slug,
  shortName: s.shortName,
  tagline: getTagline(s, 'bath'),
}));

// Guides naming this service — the same link down / link back up the
// Bristol hub carries. Capped at two.
const guides = (await getCollection('blog', ({ data }) =>
  !data.draft && (data.service === service.slug || data.alsoService === service.slug)
)).slice(0, 2);

// Bath reviews, where we have them. Two of the twelve are Bath jobs.
const bathNames = new Set(areas.map((a) => a.name));
// Bath jobs, plus any heritage/lime work wherever it happened. These pages
// are built on the claim that we handle listed and lime-compatible systems,
// and until now nothing on the site evidenced it. The one review that does —
// "Listed building Lime Plaster system", a heritage re-render in BS8 — is
// worth more here than a Bath postcode with no heritage content.
const bathReviews = REVIEWS.filter((r) => bathNames.has(r.area) || r.heritage);
const reviews = bathReviews.length ? bathReviews : REVIEWS.slice(0, 3);

// Pricing note per area, taken from the area data rather than asserted
// here, so the page cannot drift from what the area pages say. All five,
// not just the listed ones — filtering to three made it read as though we
// only cover three, and "standard pricing" is exactly what someone in
// Newbridge or Odd Down wants to see.
const areaNotes = areas.map((a) => ({
  ...a,
  listed: /listed|conservation/i.test(a.costVariation),
}));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    // service.name carries the city ('Silicone Rendering Bristol'), which is
    // wrong here and inconsistent with the Bristol pages' bare service type.
    serviceType: prose,
    name: `${prose} in Bath`,
    provider: {
      '@type': 'LocalBusiness',
      '@id': 'https://www.kdplasteringrenderingservices.co.uk/#organization',
      name: 'KD Plastering & Rendering Services',
      telephone: '+441174094116',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '8 Roman Way, Hanham',
        addressLocality: 'Bristol',
        postalCode: 'BS15 3FH',
        addressCountry: 'GB',
      },
    },
    areaServed: { '@type': 'City', name: 'Bath' },
    description: `${prose} across Bath and the BA postcodes, including Georgian and listed properties.`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: `The ${proseLower} process, step by step`,
    description: `How KD Plastering & Rendering Services delivers a ${proseLower} project on a Bath property, from the free site visit to the 12-month aftercare check.`,
    step: service.processSteps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.title,
      text: s.description,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    url: `https://www.kdplasteringrenderingservices.co.uk/our-services/${service.slug}-bath/`,
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.bath-lead', '.faq-section details:first-of-type'],
    },
  },
];
---

<PageLayout
  title={`${prose} in Bath | ${serviceHook(service)}`}
  description={`${prose} across Bath. Georgian and listed property work, lime-compatible systems, free site visit and a fixed written quote.`}
  preloadImage={`/heroes/${service.slug}.webp`}
  canonical={`/our-services/${service.slug}-bath/`}
  ogImage={`/og/${service.slug}.jpg`}
  schema={schema}
  breadcrumbs={[
    { name: 'Our Services', href: '/our-services/' },
    { name: prose, href: `/our-services/${service.slug}-bristol/` },
    { name: 'Bath', href: `/our-services/${service.slug}-bath/` },
  ]}
  prefillService={service.shortName}
  ctaHeading={`${prose} on a Bath property?`}
  ctaText="Free site visit across the BA postcodes, a fixed written quote within 48 hours, and a straight answer on whether consent is needed."
>
  <Hero
    size="compact"
    eyebrow={['Bath · BA postcodes', prose]}
    title={`${prose} in`}
    titleAccent="Bath"
    lede={`${service.intro}`}
    primaryCta={{ label: 'Get a Free Quote', href: '/contact/#lead-form-heading' }}
    phone={{ number: '+441174094116', display: '0117 409 4116' }}
    image={`/heroes/${service.slug}.webp`}
    imageAlt=""
    trust={['Free site visit', 'Fixed written quote', warrantyBadge(service)]}
  />

  <!-- What is different about Bath. This is the reason the page exists. -->
  <section class="section">
    <div class="container container--reading">
      <header class="section-header section-header--center">
        <span class="eyebrow">Bath</span>
        <h2>What changes on a Bath property</h2>
      </header>

      {note && <p class="bath-note">{note}</p>}

      <p class="bath-lead">
        Most of what we do in Bath sits on Georgian limestone rather than the brick
        and pebbledash that dominates Bristol. That changes the specification before
        it changes the price: a solid lime-built wall needs a system that lets it
        breathe, and the wrong choice traps moisture in the masonry.
      </p>
      <p class="bath-lead">
        We survey every Bath property before quoting and tell you plainly whether
        {' '}{proseLower} is the right answer for your wall — including when it isn't.
      </p>

      <ul class="bath-constraints">
        {areaNotes.map((a) => (
          <li class:list={['bath-constraint', a.listed && 'is-listed']}>
            <span class="bath-constraint__head">
              <a href={`/bath/${a.slug}/`}>{a.name}</a>
              <span class="bath-constraint__pc">{a.postcode}</span>
              <span class="bath-constraint__tag">
                {a.listed ? 'Listed / conservation' : 'Standard pricing'}
              </span>
            </span>
            <span class="bath-constraint__note">{a.costVariation}</span>
          </li>
        ))}
      </ul>
      <p class="bath-foot">
        Listed Building Consent and conservation area approval are handled before
        we start. Where consent is needed we will say so at the site visit, not
        after the scaffold is up.
      </p>
    </div>
  </section>

  <!-- Spec, true in either city -->
  <section class="section section--alt">
    <div class="container">
      <ServiceBullets
        items={service.whatWeDo}
        variant="do"
        columns={2}
        eyebrow="What's included"
        heading={`What ${proseLower} covers`}
        lede="The same specification we work to across Bristol and Bath."
      />
    </div>
  </section>

  {gallery.length > 0 && (
    <section class="work-grid-section">
      <div class="container">
        <p class="work-grid__eyebrow">Recent work</p>
        <h2 class="work-grid__heading">{prose} we have done</h2>
        <p class="work-grid__lede">Real jobs across Bristol and Bath, photographed as we finished them. No stock photography.</p>
        <ul class="work-grid">
          {gallery.map((img) => (
            <li class="work-grid__item">
              <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
        <p class="work-grid__more">
          <a href="/our-work/">See more {proseLower} projects in the gallery</a>
        </p>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <ProblemList
        problems={service.problems}
        eyebrow="Problems we fix"
        heading={`Signs a Bath property needs ${proseLower}`}
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <BenefitGrid
        eyebrow="Why us"
        benefits={service.benefits}
        heading={`Why Choose ${prose}`}
        lede={`We've completed hundreds of ${proseLower} projects across Bristol and Bath. Here's what makes them last.`}
      />
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <ProcessTimeline
        eyebrow="How it works"
        steps={service.processSteps}
        heading="Our Process"
        lede={`Every ${proseLower} project follows the same process, in Bath as in Bristol — from your free site visit to your 12-month aftercare check.`}
      />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <MaterialGrid
        materials={service.materials}
        eyebrow="Systems"
        heading={`Materials & Systems We Use for ${prose}`}
        lede="Only BBA-certified systems from leading UK and European manufacturers. Every installation carries a manufacturer warranty as standard."
      />
    </div>
  </section>

  <!-- Cost, with the Bath premium stated rather than buried -->
  {/* Cost section removed 2026-09-02 — the figures were not confirmed.
      service.costGuide and lib/areaCosts.ts are untouched, so this is a
      render call away from returning once the bands are signed off. */}

  <ReviewCards
    reviews={reviews}
    eyebrow="Reviews"
    heading={bathReviews.length ? 'What Bath customers say' : 'What our customers say'}
    lede={bathReviews.length
      ? 'Verified reviews from work completed in Bath.'
      : 'Verified reviews from recent work across Bristol and Bath.'}
  />

  <section class="section">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Questions</span>
        <h2>Frequently Asked Questions</h2>
        <p class="lede">Everything you need to know about our {proseLower} service.</p>
      </header>
      <div class="faq-section">
        {service.faq.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <div class="faq-answer">
              <p>{f.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <RelatedServices services={relatedServices} city="bath" eyebrow="What else" />

  <section class="section section--alt">
    <div class="container">
      <AuthorityBio
        compact={true}
        name="Kyran"
        role="Founder & Lead Installer"
        qualifications={[
          'NVQ Level 3 in Plastering',
          "Johnstone's Stormshield Registered Installer",
          'Parex Approved Applicator',
          'Weber EWI Certified Installer',
          "15 years' plastering and rendering across Bristol & Bath",
        ]}
        bio={`Kyran Dyer founded KD Plastering & Rendering Services in 2014. Based in Hanham, he specifies every quote himself and is on site for the key stages of every installation — including the heritage and lime-compatible work that most Bath jobs involve.`}
      />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <AreaCoverage
        cities={['bath', 'bristol']}
        serviceSlug={service.slug}
        eyebrow="Coverage"
        heading={`${prose} across Bath & Bristol`}
        lede={`Every neighbourhood has its own ${proseLower} page — ${areas.length} across Bath and ${bristolAreaCount} across Bristol, where most of our work is.`}
        note="Based in Hanham (BS15), covering the BA and BS postcodes. Free site visits within 10 miles; further afield by arrangement. Listed building consent, conservation area consent and Building Control notification are handled on your behalf where required."
      />
      <p class="bath-foot">
        See the full <a href={`/our-services/${service.slug}-bristol/`}>{proseLower} in Bristol</a> page,
        or browse <a href="/our-work/">recent work</a> across both cities.
      </p>
    </div>
  </section>

  {guides.length > 0 && (
    <section class="section">
      <div class="container">
        <header class="section-header section-header--center">
          <span class="eyebrow">Before you commit</span>
          <h2>Worth reading first</h2>
        </header>
        <ul class="bath-guides">
          {guides.map((g) => (
            <li>
              <a href={`/blog/${g.id}/`}>
                <span class="bath-guides__title">{g.data.title}</span>
                <span class="bath-guides__desc">{g.data.description}</span>
                <span class="bath-guides__meta">{g.data.minutes} min read</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</PageLayout>

<style>
  .bath-note {
    margin: 0 0 var(--sp-5);
    padding-left: var(--sp-4);
    border-left: 3px solid var(--accent);
    font-size: var(--fs-md);
    line-height: 1.7;
    color: var(--text);
  }
  .bath-lead {
    font-size: var(--fs-md);
    line-height: 1.75;
    color: var(--text-secondary);
    margin: 0 0 var(--sp-4);
  }
  .bath-constraints {
    list-style: none;
    margin: var(--sp-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--sp-3);
  }
  .bath-constraint {
    display: grid;
    gap: var(--sp-2);
    padding: var(--sp-4);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-left: 3px solid var(--border);
    border-radius: var(--radius-md);
  }
  /* Only the areas that actually carry the premium get the accent edge. */
  .bath-constraint.is-listed { border-left-color: var(--accent); }
  .bath-constraint__head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .bath-constraint__head a {
    font-weight: var(--weight-semi);
    color: var(--text);
    text-decoration: none;
    font-size: var(--fs-md);
  }
  .bath-constraint__head a:hover { color: var(--accent-text); }
  .bath-constraint__pc {
    font-size: var(--fs-xs);
    font-weight: var(--weight-bold);
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
  }
  .bath-constraint__tag {
    margin-left: auto;
    font-size: var(--fs-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .bath-constraint__note {
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* Links inside body copy need more than colour to be distinguishable. */
  .bath-foot a {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .bath-foot {
    max-width: 780px;
    margin: var(--sp-4) auto 0;
    font-size: var(--fs-sm);
    line-height: 1.65;
    color: var(--text-muted);
  }

  .bath-costs { list-style: none; margin: 0 auto; padding: 0; max-width: 780px; }
  .bath-costs li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--border);
  }
  .bath-costs li:first-child { border-top: 1px solid var(--border); }
  .bath-costs__type { font-weight: var(--weight-semi); color: var(--text); }
  .bath-costs__price {
    font-weight: var(--weight-bold);
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }


  .bath-guides {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--sp-4);
    max-width: 1000px;
  }
  .bath-guides li { display: flex; }
  .bath-guides a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 100%;
    padding: var(--sp-5);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .bath-guides a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .bath-guides__title { font-size: var(--fs-md); font-weight: var(--weight-bold); color: var(--text); }
  .bath-guides__desc { font-size: var(--fs-sm); line-height: 1.6; color: var(--text-muted); }
  .bath-guides__meta {
    margin-top: auto;
    padding-top: var(--sp-3);
    font-size: var(--fs-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--accent-text);
  }

  /* Recent-work grid — same treatment as the Bristol service hubs. */
  .work-grid-section { padding: var(--space-3xl, 4rem) 0; background: var(--surface-2, #f6f6f4); }
  .work-grid__eyebrow {
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--accent-text); margin: 0 0 0.5rem;
  }
  .work-grid__heading { margin: 0 0 0.4rem; }
  .work-grid__lede { margin: 0 0 1.75rem; color: var(--text-muted, #555); max-width: 60ch; }
  .work-grid__more { margin: 1.5rem 0 0; font-size: var(--fs-sm); }
  .work-grid__more a { color: var(--accent-text); font-weight: var(--weight-semi); }
  .work-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 1rem;
  }
  .work-grid__item { margin: 0; }
  .work-grid__item img {
    display: block; width: 100%; aspect-ratio: 3 / 4; object-fit: cover;
    border-radius: 6px; background: var(--surface, #eee);
  }

  @media (max-width: 640px) {
    .work-grid { grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }
  }
  @media (max-width: 600px) {
    .bath-costs li { flex-direction: column; gap: var(--sp-1); }
  }
</style>
