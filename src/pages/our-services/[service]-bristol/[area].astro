---
import PageLayout from '../../../layouts/PageLayout.astro';
import Hero from '../../../components/Hero.astro';
import ServiceBullets from '../../../components/ServiceBullets.astro';
import ReviewCards from '../../../components/ReviewCards.astro';
import { getBristolAreas, getArea } from '../../../lib/areas';
import { SERVICES, getService, serviceHook } from '../../../lib/services';
import { REVIEWS, reviewsFor } from '../../../lib/reviews';
import { getNote } from '../../../lib/serviceAreaNotes';

// service × neighbourhood, Bristol only: 6 × 15 = 90 pages.
export function getStaticPaths() {
  const areas = getBristolAreas();
  return SERVICES.flatMap((service) =>
    areas.map((area) => ({
      params: { service: service.slug, area: area.slug },
      props: { service, area },
    }))
  );
}

const { service, area } = Astro.props;

// Prose form: "Plastering Services" reads wrong mid-sentence.
const prose = service.shortName.replace(/\s+Services$/i, '');
const proseLower = prose.toLowerCase();

// Projects in this area that match this service. This is the one block that
// varies by BOTH axes, so it carries most of the per-page differentiation.
const KEYWORDS: Record<string, string[]> = {
  'silicone-rendering':       ['silicone'],
  'monocouche-rendering':     ['monocouche'],
  'external-wall-insulation': ['ewi', 'insulation'],
  'house-rendering':          ['re-render', 'full re-render', 'render on'],
  'external-wall-rendering':  ['render', 'ashlar', 'elevation'],
  'plastering-services':      ['plaster', 'skim', 'artex'],
};
const keys = KEYWORDS[service.slug] ?? [];
const matched = area.nearbyProjects.filter((p: string) =>
  keys.some((k) => p.toLowerCase().includes(k))
);

// Reviews for this area, narrowed to this service where we have them.
const areaReviews = REVIEWS.filter((r) => r.area === area.name);
const exact = areaReviews.filter((r) => r.service.toLowerCase().includes(proseLower));
const reviews = exact.length ? exact : areaReviews.length ? areaReviews : reviewsFor(`${service.slug}-${area.slug}`);
const reviewScope = exact.length ? `${prose} in ${area.name}` : areaReviews.length ? area.name : 'Bristol & Bath';

// The one block that is true of this service in this area and nowhere
// else. Written by hand in src/lib/serviceAreaNotes.ts; the block is
// omitted until it exists rather than padded with something generic.
const note = getNote(service.slug, area.slug);

// This service's prices against this area's actual housing stock — one of
// the few blocks that varies on both axes without anything being invented.
// Plastering is quoted by room rather than house shape, so it falls back to
// its own job-type guide.

// Six of the ninety pages are the home of a real case study. Shown only
// where it actually happened.

const otherServices = SERVICES.filter((s) => s.slug !== service.slug);
// Capped at two. These ninety pages were sending 70% of their links
// sideways to each other, which recirculated authority inside the weakest
// tier of the site instead of passing it back up. Two is enough for a
// reader; the rest of the budget goes to the hubs below.
const nearby = area.nearbyAreas
  .map((s: string) => getArea(s))
  .filter((a): a is NonNullable<typeof a> => Boolean(a) && a!.city === 'bristol')
  .slice(0, 2);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${prose} in ${area.name}, Bristol`,
  serviceType: prose,
  provider: {
    '@type': 'LocalBusiness',
    '@id': 'https://www.kdplasteringrenderingservices.co.uk/#organization',
    name: 'KD Plastering & Rendering Services',
    telephone: '+441174094116',
  },
  areaServed: {
    '@type': 'Place',
    name: `${area.name}, Bristol`,
    address: { '@type': 'PostalAddress', addressLocality: area.name, postalCode: area.postcode, addressCountry: 'GB' },
  },
};
---

<PageLayout
  title={`${prose} in ${area.name} ${area.postcode} | ${serviceHook(service)}`}
  description={`${prose} in ${area.name}, Bristol ${area.postcode}. Free site visit, fixed written quote within 48 hours, 10-year warranty.`}
  preloadImage={`/heroes/${service.slug}.webp`}
  canonical={`/our-services/${service.slug}-bristol/${area.slug}/`}
  schema={schema}
  breadcrumbs={[
    { name: 'Our Services', href: '/our-services/' },
    { name: service.shortName, href: `/our-services/${service.slug}-bristol/` },
    { name: area.name, href: `/our-services/${service.slug}-bristol/${area.slug}/` },
  ]}
  ctaHeading={`${prose} in ${area.name}?`}
  ctaText={`Free site visit across ${area.name} ${area.postcode}, a fixed written quote within 48 hours, and no pressure either way.`}
>
  <Hero
    size="compact"
    eyebrow={[`${area.name} · ${area.postcode}`, prose]}
    title={`${prose} in`}
    titleAccent={area.name}
    lede={area.intro}
    primaryCta={{ label: 'Get a Free Quote', href: '/contact/#lead-form-heading' }}
    phone={{ number: '+441174094116', display: '0117 409 4116' }}
    image={`/heroes/${service.slug}.webp`}
    imageAlt=""
    trust={['Free site visit', 'Fixed written quote', '10-year warranty']}
  />

  <!-- Area context, framed for this service -->
  <section class="section">
    <div class="container">
      <div class="media-split">
        <div class="media-split__copy">
          {note && (
            <p class="sxa-note">{note}</p>
          )}
          <p class="sxa-lead">{service.longIntro}</p>
          <p class="sxa-lead">{area.longIntro}</p>
        </div>
        <figure class="media-split__media">
          <img
            src={`/services/cards/${service.slug === 'external-wall-rendering' ? 'ewall-rendering' : service.slug === 'external-wall-insulation' ? 'ewi' : service.slug === 'plastering-services' ? 'plastering' : service.slug}.webp`}
            alt=""
            width="760" height="475" loading="lazy" decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- Projects matching this service in this area -->
  {matched.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <header class="section-header section-header--center">
          <span class="eyebrow">Recent work</span>
          <h2>{prose} we've done in {area.name}</h2>
        </header>
        <ul class="sxa-projects">
          {matched.map((p: string) => <li>{p}</li>)}
        </ul>
      </div>
    </section>
  )}

  <!-- What this service actually solves -->
  <section class="section section--alt">
    <div class="container">
      <ServiceBullets
        items={service.problems}
        variant="dont"
        columns={2}
        eyebrow="Problems we fix"
        heading={`When ${area.name} homeowners call us about ${proseLower}`}
        lede="If any of these sound like your property, this is the service you want."
      />
    </div>
  </section>

  <!-- Housing stock for this area -->
  <section class="section">
    <div class="container">
      <ServiceBullets
        items={area.propertyTypes}
        variant="do"
        columns={3}
        eyebrow="Housing stock"
        heading={`${area.name} properties we ${proseLower.includes("plaster") ? "plaster" : "render"}`}
        lede={`What ${proseLower} typically involves on the housing stock here.`}
      />
    </div>
  </section>

  {/* Cost section removed 2026-09-02 — the figures were not confirmed.
      service.costGuide and lib/areaCosts.ts are untouched, so this is a
      render call away from returning once the bands are signed off. */}

  {/* "Real Project" case study removed 2026-09-02, pre-launch. The
      CaseStudy component and the `caseStudy` entries in services.ts are
      untouched — this is only the render call. The copy makes very
      specific claims (a rival's £8,500 quote, 105m², 8 working days,
      "25-year maintenance-free") that want evidencing before they go back
      up, ideally alongside photographs of the job. */}

  <!-- Local knowledge -->
  <section class="section section--alt">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Local knowledge</span>
        <h2>Working in {area.name}</h2>
      </header>
      <div class="sxa-facts">
        <div class="sxa-fact">
          <h3>Access &amp; parking</h3>
          <p>{area.transport}</p>
        </div>
        <div class="sxa-fact">
          <h3>Who lives here</h3>
          <p>{area.demographics}</p>
        </div>
        <div class="sxa-fact">
          <h3>Landmarks we work around</h3>
          <ul class="sxa-chips">{area.landmarks.map((l: string) => <li>{l}</li>)}</ul>
        </div>
        <div class="sxa-fact">
          <h3>Pricing notes</h3>
          <p>{area.costVariation}</p>
        </div>
      </div>
    </div>
  </section>

  <ReviewCards
    reviews={reviews}
    eyebrow="Reviews"
    heading={`What ${reviewScope} customers say`}
    lede="Verified reviews from recent work."
  />

  <!-- Cross-links: other services here, and this service nearby -->
  <section class="section section--alt">
    <div class="container">
      <div class="sxa-links">
        <div>
          <h3 class="sxa-links__title">Other services in {area.name}</h3>
          <ul class="sxa-links__list">
            {otherServices.map((s) => (
              <li>
                <a href={`/our-services/${s.slug}-bristol/${area.slug}/`}>
                  {s.shortName.replace(/\s+Services$/i, '')} in {area.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="sxa-links__title">{prose} nearby</h3>
          <ul class="sxa-links__list">
            {nearby.map((a) => (
              <li>
                <a href={`/our-services/${service.slug}-bristol/${a.slug}/`}>
                  {prose} in {a.name} <span>{a.postcode}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      {/* Upward links. This page pointed at its service landing page and nothing
          else — no route back to the neighbourhood hub or the city, so the tail
          held authority it had no way to pass on. */}
      <ul class="sxa-up">
        <li>
          <a href={`/our-services/${service.slug}-bristol/`}>
            <span class="sxa-up__label">All {proseLower}</span>
            <span class="sxa-up__sub">All 15 Bristol neighbourhoods</span>
          </a>
        </li>
        <li>
          <a href={`/bristol/${area.slug}/`}>
            <span class="sxa-up__label">Plastering &amp; rendering in {area.name}</span>
            <span class="sxa-up__sub">All six services, {area.postcode}</span>
          </a>
        </li>
        <li>
          <a href="/bristol/">
            <span class="sxa-up__label">Bristol coverage</span>
            <span class="sxa-up__sub">15 neighbourhoods</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</PageLayout>

<style>
  .sxa-up {
    list-style: none;
    margin: var(--sp-6) 0 0;
    padding: var(--sp-5) 0 0;
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--sp-3);
  }
  .sxa-up a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    height: 100%;
    padding: var(--sp-4);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .sxa-up a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .sxa-up__label { font-weight: var(--weight-semi); color: var(--text); font-size: var(--fs-sm); }
  .sxa-up__sub { font-size: var(--fs-xs); color: var(--text-muted); }

  .sxa-costs { list-style: none; margin: 0 auto; padding: 0; max-width: 780px; }
  .sxa-cost {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--border);
  }
  .sxa-cost:first-child { border-top: 1px solid var(--border); }
  .sxa-cost__type { font-weight: var(--weight-semi); color: var(--text); }
  .sxa-cost__price {
    font-weight: var(--weight-bold);
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .sxa-costs__note {
    max-width: 780px;
    margin: var(--sp-4) auto 0;
    font-size: var(--fs-sm);
    line-height: 1.65;
    color: var(--text-muted);
  }

  .sxa-case { margin: 0; display: grid; gap: var(--sp-4); }
  .sxa-case > div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: var(--sp-4);
    align-items: baseline;
  }
  .sxa-case dt {
    font-size: var(--fs-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-on-dark);
  }
  .sxa-case dd { margin: 0; line-height: 1.7; }
  @media (max-width: 600px) {
    .sxa-case > div { grid-template-columns: 1fr; gap: var(--sp-1); }
    .sxa-cost { flex-direction: column; gap: var(--sp-1); }
  }

  /* Leads the page when present — it is the part that is specific to this
     service in this area. */
  .sxa-note {
    margin: 0 0 var(--sp-5);
    padding-left: var(--sp-5);
    border-left: 3px solid var(--accent);
    font-size: var(--fs-md);
    line-height: 1.7;
    color: var(--text);
  }

  .sxa-lead { font-size: var(--fs-md); line-height: 1.75; color: var(--text-secondary); }

  .sxa-projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--sp-3);
    max-width: var(--container-narrow);
    margin-inline: auto;
  }
  .sxa-projects li {
    position: relative;
    padding: var(--sp-4) var(--sp-4) var(--sp-4) var(--sp-6);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--text-secondary);
  }
  .sxa-projects li::before {
    content: '';
    position: absolute;
    left: var(--sp-4);
    top: 1.35em;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .sxa-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: var(--sp-4);
  }
  .sxa-fact {
    padding: var(--sp-5);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .sxa-fact h3 {
    margin: 0 0 var(--sp-3);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--text-muted);
  }
  .sxa-fact p { margin: 0; font-size: var(--fs-sm); line-height: 1.6; color: var(--text-secondary); }
  .sxa-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .sxa-chips li {
    padding: var(--sp-1) var(--sp-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: var(--fs-xs);
    color: var(--text-secondary);
  }

  .sxa-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--sp-6);
  }
  .sxa-links__title {
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--text-muted);
  }
  .sxa-links__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--sp-2); }
  .sxa-links__list a {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-4);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: var(--fs-sm);
    text-decoration: none;
    color: var(--text);
    transition: border-color var(--dur-fast) var(--ease);
  }
  .sxa-links__list a:hover { border-color: var(--accent); color: var(--accent-text); }
  .sxa-links__list span {
    font-size: var(--fs-xs);
    font-weight: var(--weight-bold);
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
  }

</style>
