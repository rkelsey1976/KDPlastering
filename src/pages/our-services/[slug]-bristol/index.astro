---
import PageLayout from '../../../layouts/PageLayout.astro';
import Hero from '../../../components/Hero.astro';
import AreaCoverage from '../../../components/AreaCoverage.astro';
import BenefitGrid from '../../../components/BenefitGrid.astro';
import ProcessTimeline from '../../../components/ProcessTimeline.astro';
import MaterialGrid from '../../../components/MaterialGrid.astro';
import ReviewCards from '../../../components/ReviewCards.astro';
import AuthorityBio from '../../../components/AuthorityBio.astro';
import ProblemList from '../../../components/ProblemList.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import { SERVICE_GALLERY } from '../../../lib/serviceGallery';
import ServiceBullets from '../../../components/ServiceBullets.astro';
import { getService, getRelatedServices, warrantyBadge } from '../../../lib/services';
import { AREAS } from '../../../lib/areas';
import { REVIEWS } from '../../../lib/reviews';
import { getCollection } from 'astro:content';
import { getBathAreas, getBristolAreas } from '../../../lib/areas';

const BATH_AREA_NAMES = new Set(getBathAreas().map((a) => a.name));
const bristolAreaCount = getBristolAreas().length;


export function getStaticPaths() {
  const slugs = [
    'silicone-rendering',
    'house-rendering',
    'external-wall-rendering',
    'monocouche-rendering',
    'plastering-services',
    'external-wall-insulation',
  ];
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const service = getService(slug!);
if (!service) throw new Error(`Service not found: ${slug}`);

const relatedServices = getRelatedServices(slug!);

// shortName is a label, not a noun phrase: "Plastering Services" reads
// wrong mid-sentence ("the plastering services work we take on"). This is
// the prose form — headings still use the full shortName.
const serviceProse = service.shortName.replace(/\s+Services$/i, '').toLowerCase();
// Title-case form for headings that read as a sentence: "How Much Does
// Plastering Services Cost?" is not English.
const serviceTitle = service.shortName.replace(/\s+Services$/i, '');

// Guides naming this service. Capped at two: the point is a relevant link
// down and a link back up, not a link farm.
const guides = (await getCollection('blog', ({ data }) =>
  !data.draft && (data.service === service.slug || data.alsoService === service.slug)
)).slice(0, 2);



// Intro photograph — a different frame from the hero, so the top of the
// page does not show the same house twice.
const introImages: Record<string, string> = {
  'silicone-rendering':       '/services/gallery/silicone-rendering-2.webp',
  'house-rendering':          '/services/gallery/house-rendering-1.webp',
  'external-wall-rendering':  '/services/gallery/ewall-rendering-2.webp',
  'monocouche-rendering':     '/services/gallery/monocouche-rendering-2.webp',
  'plastering-services':      '/services/gallery/plastering-1.webp',
  'external-wall-insulation': '/services/gallery/ewi-1.webp',
};
const introAlt: Record<string, string> = {
  'silicone-rendering':       'New-build home finished in smooth off-white silicone render',
  'house-rendering':          'Rear elevation with render, timber dormer and bi-fold doors',
  'external-wall-rendering':  'Close-up of a steel trowel smoothing cream render',
  'monocouche-rendering':     'Large traditional detached house finished in cream monocouche render',
  'plastering-services':      'Finished interior room with smooth white plastered walls',
  'external-wall-insulation': 'EPS insulation boards being mechanically fixed to an external wall',
};

// Recent-work grid. Empty for a service with no photos yet, and the section
// is omitted rather than rendered as an empty box.
const gallery = SERVICE_GALLERY[service.slug] ?? [];
const reviewsForService = REVIEWS
  .filter((r) => r.service.toLowerCase().includes(service.shortName.toLowerCase().split(' ')[0]))
  // Bath jobs are the proof on the Bath page, not here. Filter before the
  // slice, or dropping one leaves two reviews instead of pulling in a third.
  .filter((r) => !BATH_AREA_NAMES.has(r.area))
  .slice(0, 3);

// Build comprehensive Service + LocalBusiness + FAQPage + Offer schema
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: service.shortName,
    name: service.name,
    description: service.longIntro,
    provider: {
      '@type': 'LocalBusiness',
      name: 'KD Plastering & Rendering Services',
      '@id': 'https://www.kdplasteringrenderingservices.co.uk/#organization',
      telephone: '+441174094116',
      email: 'kdplasteringltd@gmail.com',
      url: 'https://www.kdplasteringrenderingservices.co.uk',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '8 Roman Way, Hanham',
        addressLocality: 'Bristol',
        postalCode: 'BS15 3FH',
        addressCountry: 'GB',
      },
      areaServed: { '@type': 'City', name: 'Bristol' },
    },
    areaServed: { '@type': 'City', name: 'Bristol' },
    // AggregateOffer and OfferCatalog removed 2026-09-02. They published
    // unconfirmed price bands as structured data, which Google can surface
    // directly in results — worse than having them in copy. Restore with
    // the on-page cost sections once the figures are signed off.
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: service.faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  },
];
---

<PageLayout
  title={service.titleTemplate}
  description={service.metaDescription}
  preloadImage={`/heroes/${service.slug}.webp`}
  canonical={`/our-services/${slug}-bristol/`}
  breadcrumbs={[{ name: 'Our Services', href: '/our-services/' }, { name: service.shortName, href: `/our-services/${service.slug}-bristol/` }]}
  prefillService={service.shortName}
  schema={schema}
  formHeading={`Get Your Free ${service.shortName} Quote`}
>
  <Hero
    size="compact"
    eyebrow={[`${service.shortName} in Bristol`]}
    title={service.name}
    lede={service.intro}
    primaryCta={{ label: 'Get a Free Quote', href: '/contact/#lead-form-heading' }}
    phone={{ number: '+441174094116', display: '0117 409 4116' }}
    image={`/heroes/${service.slug}.webp`}
    imageAlt={service.heroImageAlt ?? ''}
    trust={['10+ years experience', '290+ verified reviews', 'Fully insured', warrantyBadge(service)]}
  />

  <section class="section">
    <div class="container">
      <div class="intro-split">
        <div class="intro-split__copy">
          <p>{service.longIntro}</p>
        </div>
        <figure class="intro-split__media">
          <img
            src={introImages[service.slug]}
            alt={introAlt[service.slug] ?? ''}
            width="920"
            height="613"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>

      <ServiceBullets
        eyebrow="What we do"
        items={service.whatWeDo}
        variant="do"
        columns={4}
        heading="What We Do"
        lede={`The ${serviceProse} work we take on across Bristol — every project, every property type.`}
      />
    </div>
  </section>

  {gallery.length > 0 && (
    <section class="work-grid-section">
      {/* .container is the global wrapper in global.css. .wrap is scoped to
          another component, so using it here produced a zero-width box. */}
      <div class="container">
        <p class="work-grid__eyebrow">Recent work</p>
        <h2 class="work-grid__heading">{serviceProse.charAt(0).toUpperCase() + serviceProse.slice(1)} we have done</h2>
        <p class="work-grid__lede">Real jobs, photographed as we finished them. No stock photography.</p>
        <ul class="work-grid">
          {gallery.map((img) => (
            <li class="work-grid__item">
              <img
                src={img.src}
                alt={img.alt}
                width={img.width}
                height={img.height}
                loading="lazy"
                decoding="async"
              />
            </li>
          ))}
        </ul>
        <p class="work-grid__more">
          <a href="/our-work/">See more {serviceProse} projects in the gallery</a>
        </p>
      </div>
    </section>
  )}

  {/* Named jobs people search for individually — and that the Google
      Business Profile lists as separate services. Anchored so a GBP entry
      can deep-link straight to the right block instead of needing a thin
      page of its own. */}
  {service.subServices && (
    <section class="section" aria-labelledby="sub-services-heading">
      <div class="container">
        <header class="section-header section-header--center">
          <span class="eyebrow">Specific jobs</span>
          <h2 id="sub-services-heading">{serviceProse} we're asked for by name</h2>
          <p class="lede">Each is part of the same service — tell us which one you need and we'll quote it on its own.</p>
        </header>
        <ul class="subsvc">
          {service.subServices.map((sub) => (
            <li id={sub.id} class="subsvc__item">
              <h3 class="subsvc__name">{sub.name}</h3>
              <p class="subsvc__summary">{sub.summary}</p>
              <a class="subsvc__cta" href="/contact/#lead-form-heading">
                Get a quote for this
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}


  <section class="section section--alt">
    <div class="container">
    <ProblemList
    eyebrow="Common problems"
      problems={service.problems}
      heading={`Signs you need ${serviceProse}`}
      lede="If any of these sound like your property, it's worth booking a free site visit."
    />
    </div>
  </section>

  <section class="section">
    <div class="container">
    <BenefitGrid
    eyebrow="Why us"
      benefits={service.benefits}
      heading={`Why Choose ${serviceTitle}`}
      lede={`We've completed hundreds of ${serviceProse} projects across Bristol. Here's what makes them last.`}
    />
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
    <ProcessTimeline
    eyebrow="How it works"
      steps={service.processSteps}
      heading="Our Process"
      lede={`Every ${service.shortName.toLowerCase()} project follows the same 8-12 step process. Here's what to expect from your free site visit to your 12-month aftercare check.`}
    />
    </div>
  </section>


  <section class="section">
    <div class="container">
    <MaterialGrid
    eyebrow="Systems"
      materials={service.materials}
      heading={`Materials & Systems We Use for ${serviceTitle}`}
      lede="We only use BBA-certified systems from leading UK and European manufacturers. Every installation carries a manufacturer warranty as standard."
    />
    </div>
  </section>

  {/* "Real Project" case study removed 2026-09-02, pre-launch. The CaseStudy
      component and the `caseStudy` entries in services.ts are untouched — this
      was the render call plus its own <section> wrapper, which was left behind
      on the first pass and rendered as an empty padded band on all six Bristol
      service pages. Restore both together when the claims can be evidenced. */}

  {reviewsForService.length > 0 && (
    <ReviewCards
      eyebrow="Reviews"
      reviews={reviewsForService}
      heading={`${service.shortName} Reviews`}
      lede={`Verified customer reviews from our ${service.shortName.toLowerCase()} installations across Bristol.`}
    />
  )}

  <section class="section">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Questions</span>
        <h2>Frequently Asked Questions</h2>
        <p class="lede">Everything you need to know about our {service.shortName.toLowerCase()} service.</p>
      </header>
      <div class="faq-section">
        {service.faq.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <div class="faq-answer">
              <p>{f.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <RelatedServices services={relatedServices} eyebrow="What else" />

  <section class="section section--alt">
    <div class="container">
      <AuthorityBio
          compact={true}
        name="Kyran"
        role="Founder & Lead Installer"
        qualifications={[
          'NVQ Level 3 in Plastering',
          'Johnstone\'s Stormshield Registered Installer',
          'Parex Approved Applicator',
          'Weber EWI Certified Installer',
          '10+ years plastering and rendering experience across Bristol & Bath',
        ]}
        bio={`Kyran founded KD Plastering & Rendering Services in 2014 after 10 years working for larger Bristol contractors. Based in Hanham, he leads every project personally and is on site for the key stages of every installation. Kyran specifies every quote himself and oversees the team of four full-time installers. He holds NVQ Level 3 in Plastering and certified installer status with Johnstone's, Parex and Weber.`}
      />
    </div>
  </section>

  {guides.length > 0 && (
    <section class="section">
      {/* Not .container--reading — that anchors children to the left grid edge
          at 800px, so the centred header sat 176px right of its own cards. */}
      <div class="container">
        <header class="section-header section-header--center">
          <span class="eyebrow">Before you commit</span>
          <h2>Worth reading first</h2>
        </header>
        <ul class="svc-guides">
          {guides.map((g) => (
            <li>
              <a href={`/blog/${g.id}/`}>
                <span class="svc-guides__title">{g.data.title}</span>
                <span class="svc-guides__desc">{g.data.description}</span>
                <span class="svc-guides__meta">
                  {g.data.minutes} min read
                  <svg class="svc-guides__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M1 7h11M7.5 2.5 12 7l-4.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      {/* Bath's six service pages were reachable only from /bath/ and the
          five Bath area pages — an eighth of the authority their Bristol
          equivalents carry. */}
      <p class="svc-othercity">
        Property in Bath? See <a href={`/our-services/${service.slug}-bath/`}>{service.shortName.replace(/\s+Services$/i, '').toLowerCase()} in Bath</a>,
        where most of the work is Georgian and lime-compatible.
      </p>

      <AreaCoverage
        cities={['bristol']}
        serviceSlug={service.slug}
        eyebrow="Coverage"
        heading={`${serviceTitle} Across Bristol`}
        lede={`We cover all ${bristolAreaCount} Bristol neighbourhoods, with consistent pricing within the BS postcodes.`}
        note="Free site visits within 10 miles of BS15. Properties outside our standard coverage area can be quoted by arrangement. Listed building consent, conservation area consent and Building Control notification are handled on your behalf where required."
      />
    </div>
  </section>
</PageLayout>

<style>
  .svc-guides {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    /* Two up on desktop. Full-width single-column cards were short and very
       wide, which read as unfinished rows rather than cards. */
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--sp-4);
    max-width: 1000px;
  }
  .svc-guides li { display: flex; }
  .svc-guides a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 100%;
    padding: var(--sp-5);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .svc-guides a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .svc-guides a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .svc-guides__arrow { transition: transform var(--dur-fast) var(--ease); }
  .svc-guides a:hover .svc-guides__arrow { transform: translateX(3px); }
  @media (prefers-reduced-motion: reduce) {
    .svc-guides a, .svc-guides__arrow { transition: none; }
    .svc-guides a:hover { transform: none; }
  }
  .svc-guides__title { font-size: var(--fs-md); font-weight: var(--weight-bold); color: var(--text); }
  .svc-guides__desc { font-size: var(--fs-sm); line-height: 1.6; color: var(--text-muted); }
  .svc-guides__meta {
    /* auto pushes the meta line to the bottom so the two cards agree on where
       it sits, whatever the description length */
    margin-top: auto;
    padding-top: var(--sp-3);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--accent-text);
  }

  .subsvc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--sp-3);
  }
  .subsvc__item {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-5);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-md);
    scroll-margin-top: calc(var(--header-h, 5rem) + var(--sp-5));
  }
  .subsvc__name { margin: 0; font-size: var(--fs-md); font-weight: var(--weight-bold); color: var(--text); }
  .subsvc__summary { margin: 0; flex: 1; font-size: var(--fs-sm); line-height: 1.65; color: var(--text-muted); }
  .subsvc__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    font-weight: var(--weight-semi);
    color: var(--accent-text);
    text-decoration: none;
  }
  .subsvc__cta:hover { text-decoration: underline; }

  .svc-othercity {
    max-width: 780px;
    margin: 0 auto var(--sp-6);
    text-align: center;
    font-size: var(--fs-sm);
    line-height: 1.65;
    color: var(--text-muted);
  }
  .svc-othercity a { color: var(--accent-text); font-weight: var(--weight-semi); }

  /* Intro: copy beside a photograph, no tinted panel. The callout styling
     made the opening paragraph look like an aside rather than the lead. */
  .intro-split {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--sp-7);
    align-items: center;
    margin: 0 0 var(--sp-7);
  }
  .intro-split__copy p {
    margin: 0;
    font-size: var(--fs-md);
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 58ch;
  }
  .intro-split__media {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-sunken);
  }
  .intro-split__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  @media (max-width: 860px) {
    .intro-split { grid-template-columns: 1fr; gap: var(--sp-5); }
    .intro-split__media { order: -1; }
  }
  @media (max-width: 640px) {
  }

  /* Page-local styles only — design system tokens from global.css */
  /* Narrow measure for readability, but anchored to the site grid so the
     headline starts on the same left edge as the header logo. Centring it
     put the h1 240px right of the logo. */


  /* Service bullets grid (8 bullets from service.whatWeDo) */
  .service-bullets {
    list-style: none;
    padding: 0;
    margin: var(--sp-5) 0 var(--sp-7);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--sp-3);
  }
  .service-bullets li {
    background: #fff;
    border-left: 3px solid var(--accent);
    padding: var(--sp-4) var(--sp-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    box-shadow: var(--shadow-xs);
    color: var(--text);
    margin: 0;
  }

  /* Section headings alignment */
  .section-lede {
    text-align: center;
    color: var(--text-muted);
    font-size: var(--fs-lg);
    max-width: 60ch;
    margin: 0 auto var(--sp-7);
  }

  /* Areas inline detail grid (replaces 12-card grid + 120 matrix pages) */
  .area-group-heading:first-of-type { margin-top: var(--sp-5); }
  .area-detail:hover { border-color: var(--surface-inverse); }

  /* ── Recent work grid ── */
  .work-grid-section { padding: var(--space-3xl, 4rem) 0; background: var(--surface-2, #f6f6f4); }
  .work-grid__eyebrow {
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--accent-text); margin: 0 0 0.5rem;
  }
  .work-grid__heading { margin: 0 0 0.4rem; }
  .work-grid__lede { margin: 0 0 1.75rem; color: var(--text-muted, #555); max-width: 60ch; }
  .work-grid__more { margin: 1.5rem 0 0; font-size: var(--fs-sm); }
  .work-grid__more a { color: var(--accent-text); font-weight: var(--weight-semi); }
  .work-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 1rem;
  }
  .work-grid__item { margin: 0; }
  /* Portrait interiors and landscape elevations sit in the same grid, so a
     fixed ratio keeps the rows even without distorting either. */
  .work-grid__item img {
    display: block; width: 100%; aspect-ratio: 3 / 4; object-fit: cover;
    border-radius: 6px; background: var(--surface, #eee);
  }
  @media (max-width: 640px) {
    .work-grid { grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }
  }
</style>
