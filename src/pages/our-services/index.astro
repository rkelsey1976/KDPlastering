---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import AreaCoverage from '../../components/AreaCoverage.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { SERVICES, getService } from '../../lib/services';
import { AREAS, getBristolAreas, getBathAreas } from '../../lib/areas';

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'Plasterer'],
  name: 'KD Plastering & Rendering Services',
  url: 'https://www.kdplasteringrenderingservices.co.uk',
  telephone: '0117 409 4116',
  email: 'kdplasteringltd@gmail.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '8 Roman Way, Hanham',
    addressLocality: 'Bristol',
    postalCode: 'BS15 3FH',
    addressCountry: 'GB',
  },
  areaServed: [
    { '@type': 'City', name: 'Bristol' },
    { '@type': 'City', name: 'Bath' },
  ],
  priceRange: '££',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '180',
  },
};

// Same card-sized WebP the homepage grid uses — the icons here were the
// only place on the site showing a service without a photograph of it.
const serviceImages: Record<string, string> = {
  'silicone-rendering':       '/services/cards/silicone-rendering.webp',
  'house-rendering':          '/services/cards/house-rendering.webp',
  'external-wall-rendering':  '/services/cards/ewall-rendering.webp',
  'monocouche-rendering':     '/services/cards/monocouche-rendering.webp',
  'plastering-services':      '/services/cards/plastering.webp',
  'external-wall-insulation': '/services/cards/ewi.webp',
};

const bristol = getBristolAreas();
const bath = getBathAreas();

// Price hints per service (subset)
---

<PageLayout
  title="Plastering & Rendering Services in Bristol & Bath | KD Plastering"
  description="All our plastering, rendering and external wall insulation services across Bristol and Bath. Silicone, monocouche, K Rend, Parex — 10-year warranty, fully insured, free quotes."
  canonical="/our-services/"
  schema={localBusiness}
  breadcrumbs={[{ name: 'Our Services', href: '/our-services/' }]}
  ctaHeading="Not sure which service you need?"
  ctaText="Tell us about your property and we'll recommend the right system — silicone, monocouche, acrylic, sand-and-cement or EWI. Free site visit, free written quote, no pressure."
  ctaLabel="Get a Free Recommendation"
>
  <Hero
    size="compact"
    eyebrow={['Our services']}
    title="Plastering & Rendering Services in"
    titleAccent="Bristol & Bath"
    lede="Six specialist services covering every type of internal plastering, external rendering and external wall insulation across 20 Bristol & Bath neighbourhoods."
    primaryCta={{ label: 'Explore our services', href: '#services-grid' }}
    phone={{ number: '01174094116', display: '0117 409 4116' }}
    image="/heroes/our-services.webp"
    imageAlt=""
    trust={['Six specialist services', '20 neighbourhoods', 'Fully insured', 'Free site visits']}
  />

  <!-- Six services -->
  <section class="section" id="services-grid">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow eyebrow--clay">What we do</span>
        <h2>Six core services</h2>
        <p class="lede">Every type of internal plastering, external rendering and external wall insulation across Bristol &amp; Bath. Each service is fully insured, BBA-certified, and backed by a 10-year manufacturer warranty.</p>
      </header>

      <div class="service-grid-3">
        {SERVICES.map((service, i) => (
          <ServiceCard
            slug={service.slug}
            shortName={service.shortName}
            tagline={service.tagline}
            imageSrc={serviceImages[service.slug]}
            number={String(i + 1).padStart(2, '0')}
            variant="default"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Service areas -->
  <section class="section section--alt">
    <div class="container">
        <AreaCoverage
          eyebrow="Coverage"
          heading="Service areas we cover"
          lede="Every service is available in every area we cover, with consistent pricing within BS and BA postcodes."
          note="Localised notes apply for listed buildings, conservation areas and access-restricted streets — we cover those at the site visit."
        />
    </div>
  </section>

</PageLayout>

<style>
  /* Section header */
  .section-header {
    margin-bottom: var(--sp-7);
  }
  .section-header--center {
    text-align: center;
  }
  .section-header--center .lede {
    margin-left: auto;
    margin-right: auto;
  }

  /* Service grid */
  .service-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
  }

  @media (max-width: 1000px) {
    .service-grid-3 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .service-grid-3 { grid-template-columns: 1fr; }
  }

  /* Areas by city */

  @media (max-width: 800px) {
  }

  /* Recommendation card */

  @media (max-width: 700px) {
  }




</style>