---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Cookies — KD Plastering & Rendering Services"
  description="KD Plastering doesn't use any tracking or advertising cookies. Read our short cookies policy."
  canonical="/cookies/"
>
  <article class="mx-auto max-w-3xl px-5 sm:px-8 py-16">
    <h1 class="text-4xl font-bold">Cookies</h1>
    <p class="mt-3 text-sm text-ink-700/70">Last updated: {new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
    <p class="mt-6 text-ink-700/85 leading-relaxed">We don't use any analytics, advertising, or tracking cookies. We don't load Google Analytics, Meta Pixel, or any other third-party scripts. The site is fully usable without cookies.</p>
    <p class="mt-4 text-ink-700/85 leading-relaxed">Our hosting provider (Netlify) records standard request logs for up to 30 days for security and capacity planning. See our <a href="/privacy/" class="underline">privacy policy</a> for the full details.</p>
  </article>
</BaseLayout>
