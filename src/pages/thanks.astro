---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

// Noindex and out of the sitemap. This is a conversion confirmation, not a
// landing page — if it ranks, people arrive here without having submitted
// anything and every one of them registers as a conversion.
const guides = (await getCollection('blog', ({ data }) => !data.draft)).slice(0, 2);
---

<PageLayout
  title="Thanks — we've got your details | KD Plastering"
  description="We've received your enquiry and will be in touch shortly."
  canonical="/thanks/"
  noindex={true}
  showLeadForm={false}
  showCta={false}
  breadcrumbs={[{ name: 'Thanks', href: '/thanks/' }]}
>
  <section class="section ty-hero">
    <div class="container container--reading">
      <span class="ty-tick" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6 9 17l-5-5" />
        </svg>
      </span>
      <h1>Thanks — we've got your details</h1>
      <p class="lede">
        Your enquiry is with us. Kyran or one of the team will read it personally,
        usually the same working day.
      </p>
      <p class="ty-urgent">
        Need us sooner? Call <a href="tel:+441174094116">0117 409 4116</a> or
        <a href="https://wa.me/447961114662" target="_blank" rel="noopener">message us on WhatsApp</a>.
        Mon–Fri 8am–6pm, Sat 9am–1pm.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container container--reading">
      <h2>What happens next</h2>
      {/* A real sequence, so numbering it is honest rather than decorative. */}
      <ol class="ty-steps">
        <li>
          <h3>We read it and come back to you</h3>
          <p>
            Same working day in most cases. If your project is straightforward we may be
            able to price it there and then.
          </p>
        </li>
        <li>
          <h3>Free site visit, usually within 2–3 working days</h3>
          <p>
            Most jobs need eyes on the wall. We look at the substrate, take measurements,
            and check access and scaffold. Takes 30–45 minutes and costs nothing.
          </p>
        </li>
        <li>
          <h3>Fixed written quote within 48 hours of the visit</h3>
          <p>
            Itemised, with what is and isn't included. No pressure either way — plenty of
            people take our quote and think about it, and that's fine.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container container--reading">
      <h2>What helps at the site visit</h2>
      <p>None of this is essential — it just makes the quote faster and more accurate.</p>
      <ul class="ty-prep">
        <li>Roughly when the property was built, if you know</li>
        <li>Whether it's listed or in a conservation area</li>
        <li>Any previous render or damp work, and roughly when</li>
        <li>Photos of anything you've already spotted — cracks, blown patches, damp inside</li>
        <li>Whether there's rear access for scaffold</li>
      </ul>
    </div>
  </section>

  {guides.length > 0 && (
    <section class="section section--alt">
      <div class="container container--reading">
        <h2>While you wait</h2>
        <p>Worth a read before we speak — it makes the conversation shorter.</p>
        <ul class="ty-guides">
          {guides.map((g) => (
            <li>
              <a href={`/blog/${g.id}/`}>
                <span class="ty-guides__title">{g.data.title}</span>
                <span class="ty-guides__desc">{g.data.description}</span>
                <span class="ty-guides__meta">{g.data.minutes} min read</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="ty-back"><a href="/">Back to the homepage</a></p>
      </div>
    </section>
  )}
</PageLayout>

<style>
  .ty-hero { padding-bottom: var(--sp-6); }
  .ty-tick {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    margin-bottom: var(--sp-4);
  }
  .ty-hero h1 { margin: 0 0 var(--sp-3); }
  .ty-urgent {
    margin: var(--sp-5) 0 0;
    padding-top: var(--sp-4);
    border-top: 1px solid var(--border);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  .ty-urgent a { color: var(--accent-text); font-weight: var(--weight-semi); }

  .ty-steps {
    list-style: none;
    counter-reset: ty;
    margin: var(--sp-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--sp-5);
  }
  .ty-steps li {
    counter-increment: ty;
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: var(--sp-4);
    align-items: start;
  }
  .ty-steps li::before {
    content: counter(ty);
    font-size: var(--fs-md);
    font-weight: var(--weight-bold);
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.35;
  }
  .ty-steps h3 { margin: 0 0 var(--sp-1); font-size: var(--fs-md); }
  .ty-steps p { margin: 0; color: var(--text-muted); line-height: 1.65; }

  .ty-prep { margin: var(--sp-4) 0 0; padding-left: 1.15rem; color: var(--text-secondary); }
  .ty-prep li { margin-bottom: var(--sp-2); line-height: 1.6; }

  .ty-guides { list-style: none; margin: var(--sp-4) 0 0; padding: 0; display: grid; gap: var(--sp-3); }
  .ty-guides a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: var(--sp-5);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .ty-guides a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .ty-guides__title { font-size: var(--fs-md); font-weight: var(--weight-bold); color: var(--text); }
  .ty-guides__desc { font-size: var(--fs-sm); line-height: 1.6; color: var(--text-muted); }
  .ty-guides__meta {
    margin-top: var(--sp-2);
    font-size: var(--fs-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--accent-text);
  }
  .ty-back { margin: var(--sp-5) 0 0; font-size: var(--fs-sm); }
  .ty-back a { color: var(--accent-text); }
</style>
