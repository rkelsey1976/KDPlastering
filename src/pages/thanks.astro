---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Thanks — we'll be in touch | KD Plastering"
  description="Thanks for your plastering or rendering enquiry. KD Plastering will be in touch within a few hours."
  canonical="/thanks/"
  showLeadForm={false}
  showCta={false}
  breadcrumbs={[{ name: 'Thanks', href: '/thanks/' }]}
>
  <section class="hero">
    <div class="container" style="text-align: center;">
      <h1>Thanks — we’ve got your enquiry</h1>
      <p class="lede">We’ll be in touch within a few hours with a fixed written quote.</p>
      <p>Need us sooner? Call <a href="tel:+441174094116" style="color: var(--accent-text); text-decoration: underline;">0117 409 4116</a> (Mon–Fri 8am–6pm, Sat 9am–1pm).</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 700px; text-align: center;">
      <h2>What happens next</h2>
      <p>One of our team will read your project details and either:</p>
      <ul style="text-align: left; max-width: 500px; margin: 0 auto 2rem;">
        <li>Confirm a free site visit at a time that suits you (usually within 2–3 working days), or</li>
        <li>Send a fixed written quote straight away if your project is straightforward</li>
      </ul>
      <p><a href="/" style="display: inline-block; background: var(--accent); color: var(--on-accent); padding: 0.85rem 2rem; border-radius: 4px; text-decoration: none; font-weight: 700;">Back to home</a></p>
    </div>
  </section>
</PageLayout>
