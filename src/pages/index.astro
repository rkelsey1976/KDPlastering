---
import { AREAS } from '../lib/areas';
import PageLayout from '../layouts/PageLayout.astro';
import { PROFILES, COMPANY } from '../lib/contact';
import SectionHeader from '../components/SectionHeader.astro';
import ReviewCards from '../components/ReviewCards.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Hero from '../components/Hero.astro';
import { SERVICES } from '../lib/services';
import { REVIEWS } from '../lib/reviews';

const featuredServices = SERVICES;
const featuredReviews = REVIEWS.slice(0, 3);

// Reviews: 50 on Google (4.9), 194 on Checkatrade (9.8/10), 51 on MyBuilder
// (4.7) = 295. "180+ 5-Star" was both wrong and an undercount, and not all of
// them are five-star — Checkatrade scores out of ten. "290+ verified" is the
// claim that survives someone checking it.
// "Projects Done" (previously 800+) is dropped rather than guessed at --
// nothing on record supports a specific figure. Checkatrade's 194 reviews
// implies several hundred jobs at a normal review rate, but that is an
// inference, not a count. Add it back with a real number from the books
// when Richard has one.
const heroStats = [
  { value: 10,  suffix: '+',   label: 'Years in Bristol' },
  { value: 290, suffix: '+',   label: 'Verified Reviews' },
  { value: 23,                 label: 'Areas Covered' },
  { value: 25,  suffix: ' yr', label: 'System Warranty' },
];

// Hero photo per service for the bento grid
// Card-sized WebP (760x475), not the full 1600px heroes. The grid was
// pulling 2.17MB of JPEG to fill six ~380px cards.
const serviceImages: Record<string, string> = {
  'silicone-rendering':         '/services/cards/silicone-rendering.webp',
  'house-rendering':            '/services/cards/house-rendering.webp',
  'external-wall-rendering':    '/services/cards/ewall-rendering.webp',
  'monocouche-rendering':       '/services/cards/monocouche-rendering.webp',
  'plastering-services':        '/services/cards/plastering.webp',
  'external-wall-insulation':   '/services/cards/ewi.webp',
};

// Gallery photos for the "Recent work" section
// Captions describe what is actually in each frame (see
// public/services/MANIFEST.md) rather than inventing locations. The
// commercial-* slides name the client (Asda, HSBC — both Bristol, 2026);
// Richard confirmed both may be named.
// Each slide links to the service it demonstrates — real project photos
// become internal links to the pages that need them.
const galleryImages = [
  { src: '/services/gallery/commercial-1.webp',           slug: 'external-wall-rendering',  service: 'External Wall Rendering', caption: 'Asda, Bristol — rendered from a scissor lift', alt: 'KD Plastering renderers on a scissor lift working along the external wall of an Asda store in Bristol' },
  { src: '/services/gallery/ewall-rendering-1.webp',      slug: 'external-wall-rendering',  service: 'External Wall Rendering', caption: 'Spraying monocouche render',            alt: 'KD Plastering applying sprayed cream monocouche render to a house exterior' },
  { src: '/services/gallery/commercial-5.webp',           slug: 'external-wall-rendering',  service: 'External Wall Rendering', caption: 'HSBC, Bristol — ruling off a float coat', alt: 'KD Plastering plasterer ruling off a fresh float coat with a feather-edge on the HSBC bank building in Bristol' },
  { src: '/services/gallery/silicone-rendering-2.webp',   slug: 'silicone-rendering',       service: 'Silicone Rendering',      caption: 'Smooth silicone render, new build',      alt: 'New-build home finished in smooth off-white silicone render with anthracite cladding' },
  { src: '/services/gallery/ewi-1.webp',                  slug: 'external-wall-insulation', service: 'External Wall Insulation', caption: 'External wall insulation going on',     alt: 'EPS insulation boards being mechanically fixed to an external wall' },
  { src: '/services/gallery/monocouche-rendering-2.webp', slug: 'monocouche-rendering',     service: 'Monocouche Rendering',    caption: 'Traditional detached, finished',         alt: 'Large traditional detached house finished in cream monocouche render' },
  { src: '/services/gallery/ewall-rendering-2.webp',      slug: 'external-wall-rendering',  service: 'External Wall Rendering', caption: 'Trowel finish, close up',                alt: 'Close-up of a steel trowel smoothing cream render' },
  { src: '/services/gallery/commercial-3.webp',           slug: 'external-wall-rendering',  service: 'External Wall Rendering', caption: 'Asda, Bristol — finished in white render', alt: 'Long external elevation of an Asda store in Bristol finished in smooth white render' },
  { src: '/services/gallery/house-rendering-1.webp',      slug: 'house-rendering',          service: 'House Rendering',         caption: 'Rear elevation, render and dormer',      alt: 'Rear elevation with render, timber dormer and bi-fold doors' },
  { src: '/services/gallery/plastering-1.webp',           slug: 'plastering-services',      service: 'Plastering',              caption: 'Internal plastering, finished',          alt: 'Finished interior room with smooth white plastered walls' },
  // Portrait interiors — these three keep their subject in the middle third, so
  // the strip's 4:3 crop does not cut the point out of them. The Velux reveal
  // and the stairwell are deliberately left to the service page, where they can
  // run portrait.
  { src: '/services/gallery/plastering-4.webp',           slug: 'plastering-services',      service: 'Plastering',              caption: 'Victorian room, skimmed throughout',     alt: 'Victorian bay-window room skimmed throughout with original coving and an exposed brick chimney breast' },
  { src: '/services/gallery/plastering-3.webp',           slug: 'plastering-services',      service: 'Plastering',              caption: 'Loft room, ceilings and reveals',        alt: 'Loft room with three Velux windows and sloping ceilings, fully skimmed' },
  { src: '/services/gallery/plastering-7.webp',           slug: 'plastering-services',      service: 'Plastering',              caption: 'Skimming a ceiling',                     alt: 'Plasterer on a mobile tower skimming a ceiling' },
  { src: '/services/gallery/monocouche-rendering-1.webp', slug: 'monocouche-rendering',     service: 'Monocouche Rendering',    caption: 'Textured render, hand applied',          alt: 'Applying textured beige render with a steel trowel' },
  { src: '/services/gallery/ewi-2.webp',                  slug: 'external-wall-insulation', service: 'External Wall Insulation', caption: 'Completed EWI and render',              alt: 'Completed cream rendered home following external wall insulation' },
  { src: '/services/gallery/house-rendering-3.webp',      slug: 'house-rendering',          service: 'House Rendering',         caption: 'Detached front, smooth render',          alt: 'Front of a detached house in smooth off-white render with a bow bay window' },
  { src: '/services/gallery/ewall-rendering-3.webp',      slug: 'external-wall-rendering',  service: 'External Wall Rendering', caption: 'Finished in cream render',               alt: 'Finished house front in cream render' },
  { src: '/services/gallery/silicone-rendering-1.webp',   slug: 'silicone-rendering',       service: 'Silicone Rendering',      caption: 'Silicone render, colour finish',         alt: 'Mustard yellow silicone render with a charcoal accent panel' },
  { src: '/services/gallery/monocouche-rendering-3.webp', slug: 'monocouche-rendering',     service: 'Monocouche Rendering',    caption: 'White render, bay window',               alt: 'Semi-detached house in white render with a bay window' },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'Plasterer'],
  name: 'KD Plastering & Rendering Services',
  '@id': 'https://www.kdplasteringrenderingservices.co.uk/#organization',
  telephone: '+441174094116',
    contactPoint: [
      {
        '@type': 'ContactPoint',
        telephone: '+441174094116',
        contactType: 'customer service',
        areaServed: 'GB',
        availableLanguage: 'English',
      },
      {
        '@type': 'ContactPoint',
        telephone: '+447961114662',
        contactType: 'customer service',
        areaServed: 'GB',
        availableLanguage: 'English',
      },
    ],
    // Consolidates this site with the same business elsewhere.
    sameAs: PROFILES,
    // Google reads these on the LocalBusiness for the knowledge panel.
    // image: real work, not the logo. logo: the square brand mark.
    // hasMap ties the entity to the Business Profile listing itself.
    image: [
    'https://www.kdplasteringrenderingservices.co.uk/heroes/silicone-rendering.webp',
    'https://www.kdplasteringrenderingservices.co.uk/heroes/house-rendering.webp',
    'https://www.kdplasteringrenderingservices.co.uk/services/gallery/monocouche-rendering-2.webp',
    ],
    logo: 'https://www.kdplasteringrenderingservices.co.uk/icon-512.png',
    description:
    'Plastering, silicone and monocouche rendering, and external wall insulation across Bristol and Bath. Free site visits, fixed written quotes within 48 hours, 10-year warranty.',
    hasMap: 'https://maps.google.com/?cid=4018445236727357871',
    // The registered entity behind the trading name (Companies House 10957221).
    legalName: COMPANY.legalName,
    foundingDate: COMPANY.incorporated,
    identifier: {
      '@type': 'PropertyValue',
      name: 'Company number',
      value: COMPANY.number,
    },
      email: 'kdplasteringltd@gmail.com',
  url: 'https://www.kdplasteringrenderingservices.co.uk',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '8 Roman Way, Hanham',
    addressLocality: 'Bristol',
    postalCode: 'BS15 3FH',
    addressCountry: 'GB',
  },
  geo: {
    '@type': 'GeoCoordinates',
    // Taken from the Google Business Profile itself. The previous values
    // were 655m out, which undercuts the NAP match Google is checking.
    latitude: 51.4427857,
    longitude: -2.5122453,
  },
  // The same entity described three times must describe its service area
  // the same way. Cities plus every named neighbourhood — more useful to
  // Google than two city names, and it stays in step with lib/areas.
  areaServed: [
    { '@type': 'City', name: 'Bristol' },
    { '@type': 'City', name: 'Bath' },
    ...AREAS.map((a) => ({ '@type': 'Place', name: a.name })),
  ],
  priceRange: '££',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '18:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '09:00',
      closes: '13:00',
    },
  ],
};
---

<PageLayout
  title="Plastering & Rendering in Bristol & Bath | KD Plastering"
  description="Plastering, rendering and external wall insulation across Bristol and Bath. 10+ years, fully insured, 4.9 on Google. Free quotes within 48 hours."
  preloadImage="/hero-home.webp"
  canonical="/"
  schema={schema}
>
  <Hero
    eyebrow={['Bristol & Bath Plastering Specialists', 'Since 2014']}
    title="We plaster and render Bristol homes to last"
    titleAccent="25 years."
    lede="Silicone render, monocouche, house rendering and external wall insulation — fitted by Bristol's most reviewed plastering team."
    primaryCta={{ label: 'Get Your Free Quote', href: '/contact/#lead-form-heading' }}
    phone={{ number: '+441174094116', display: '0117 409 4116' }}
    image="/hero-home.webp"
    rotateWith={['/heroes/r/hero-2-1200.webp', '/heroes/r/hero-3-1200.webp', '/heroes/r/hero-4-1200.webp']}
    stats={heroStats}
  />

  <!-- 2. SERVICES — 6 cards, uniform grid -->
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="What we do"
                heading="Our services"
        lede="Every type of internal plastering, external rendering and external wall insulation across Bristol & Bath."
      />
      <div class="service-grid reveal-stagger">
        {featuredServices.map((service, i) => (
          <ServiceCard
            slug={service.slug}
            shortName={service.shortName}
            tagline={service.tagline}
            imageSrc={serviceImages[service.slug]}
            number={String(i + 1).padStart(2, '0')}
            variant="default"
          />
        ))}
      </div>
      <p class="services-more">
        <a href="/our-services/">Compare all six services and where we cover</a>
      </p>
    </div>
  </section>

  <!-- 3. PROJECT GALLERY — visual proof -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        eyebrow="Recent work"
                heading="Recent projects across Bristol & Bath"
        lede="A selection of recent rendering and plastering projects."
      />
      <div class="slider">
        <div class="slider__track" id="work-slider" tabindex="0" role="region"
             aria-label="Recent projects — scrollable">
          {galleryImages.map((img, i) => (
            <figure class="slide">
              <a
                href={`/our-services/${img.slug}-bristol/`}
                class="slide__link"
              >
                <img
                  src={img.src}
                  alt={img.alt}
                  width="920"
                  height="613"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption class="slide__caption">
                  <span class="slide__service">{img.service}</span>
                  <span class="slide__title">{img.caption}</span>
                </figcaption>
              </a>
            </figure>
          ))}
        </div>

        <div class="slider__controls">
          <button type="button" class="slider__btn" data-dir="-1" aria-controls="work-slider" aria-label="Previous projects">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" class="slider__btn" data-dir="1" aria-controls="work-slider" aria-label="More projects">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>
      <div class="gallery-cta">
        <a href="/our-work/" class="btn btn--ghost">See more of our work</a>
      </div>
    </div>
  </section>

  <!-- 4. REVIEWS + TRUST — combined trust block -->
  <section class="section">
    <div class="container">
      <ReviewCards
        reviews={featuredReviews}
        heading="What Bristol & Bath homeowners say"
        lede="Three of our most recent verified reviews."
      />

      <!-- BBA / manufacturer row -->
      <div class="trust-row">
        {/* Was "BBA-approved installer for:". The BBA certifies products and
            systems, not contractors — there is no such thing as a BBA-approved
            installer, so the claim was both wrong and unverifiable. What is true
            is that KD installs these manufacturers' BBA-certified systems. */}
        <p class="trust-row__heading">We install BBA-certified systems from:</p>
        <ul class="trust-row__logos">
          <li><img src="/logos/johnstones.png" alt="Johnstone's Trade" width="289" height="120" loading="lazy" decoding="async" /></li>
          <li><img src="/logos/k-rend.png"     alt="K Rend"           width="404" height="120" loading="lazy" decoding="async" /></li>
          <li><img src="/logos/parex.png"      alt="Parex"            width="507" height="120" loading="lazy" decoding="async" /></li>
          <li><img src="/logos/weber.png"      alt="Weber"            width="421" height="120" loading="lazy" decoding="async" /></li>
        </ul>

        {/* Kept separate from the manufacturers above. The BBA is a
            certification body, not a render maker, and putting its mark in the
            same row would read as though it were one. */}
        <ul class="trust-row__marks">
          <li>
            <img src="/logos/bba.png" alt="British Board of Agrément" width="416" height="120" loading="lazy" decoding="async" />
            <span>Systems certified by the BBA</span>
          </li>
          <li>
            <img src="/logos/johnstones-stormshield.png" alt="Johnstone's Trade Stormshield EWI &amp; Render" width="155" height="120" loading="lazy" decoding="async" />
            <span>Stormshield EWI &amp; Render approved contractor</span>
          </li>
        </ul>
      </div>
    </div>
  </section>
{/* Body link, not a nav link: a sitewide /blog/ entry would take ~3.5%
    of internal PageRank from the service pages. */}
<section class="section section--alt">
  {/* Not .container--reading: that class deliberately anchors a narrow column
      to the left grid edge so long-form copy lines up with the logo, which is
      right for /terms/, /blog/ and the rest. Here the block is meant to be
      centred, and the two intentions fought — the column hung left while the
      text centred inside it, putting this content 176px off centre. */}
  <div class="container guides-cta">
    <span class="eyebrow">Guides</span>
    <h2>Not sure what's wrong with your wall?</h2>
    <p class="lede">
      Straight answers on failing render, damp inside walls and what the work
      actually costs — from what we find on site.
    </p>
    <p style="margin: 0;"><a class="btn btn--secondary" href="/blog/">Read our guides</a></p>
    <p class="guides-cta__faq">Quick answer instead? <a href="/faqs/">See the FAQs</a>.</p>
  </div>
</section>

</PageLayout>

<script>
  // Scroll reveal animations
  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Skip animations — make everything visible immediately
      document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => el.classList.add('is-visible'));
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.05, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => observer.observe(el));

    // Recent-work slider — enhancement only. The track already scrolls by
    // swipe, trackpad and arrow keys with no JS; this just wires the
    // buttons and greys them out at each end.
    const track = document.getElementById('work-slider');
    if (track) {
      const step = () => {
        const slide = track.querySelector('.slide');
        return slide ? slide.getBoundingClientRect().width + 16 : track.clientWidth * 0.8;
      };
      const buttons = document.querySelectorAll('.slider__btn');
      const sync = () => {
        // The track has 2px of inline padding for the focus ring, and snap
        // points land on sub-pixel offsets, so scrollLeft never settles at
        // exactly 0 or exactly max. Without this tolerance the buttons
        // never grey out at either end.
        const EDGE = 6;
        const max = track.scrollWidth - track.clientWidth;
        buttons.forEach((b) => {
          const dir = Number(b.getAttribute('data-dir'));
          b.toggleAttribute(
            'disabled',
            dir < 0 ? track.scrollLeft <= EDGE : track.scrollLeft >= max - EDGE
          );
        });
      };
      buttons.forEach((b) => b.addEventListener('click', () => {
        track.scrollBy({ left: Number(b.getAttribute('data-dir')) * step(), behavior: 'smooth' });
      }));
      track.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync, { passive: true });
      sync();

      // On a touch device a horizontal swipe of the carousel ends in a
      // click on whichever slide is under the finger when it lifts — after
      // the scroll, usually not the slide the user was looking at, so they
      // land on a service page they never meant to open. If the finger
      // moved, or the track scrolled, between press and click, the gesture
      // was a swipe: swallow the click. Both pointer and touch events are
      // wired because some mobile browsers stop firing pointer events once
      // they take over the scroll.
      let startX = 0;
      let startY = 0;
      let startScroll = 0;
      let swiped = false;
      const arm = (x, y) => { startX = x; startY = y; startScroll = track.scrollLeft; swiped = false; };
      const move = (x, y) => {
        if (Math.abs(x - startX) > 8 || Math.abs(y - startY) > 8) swiped = true;
      };
      track.addEventListener('pointerdown', (e) => arm(e.clientX, e.clientY), { passive: true });
      track.addEventListener('pointermove', (e) => move(e.clientX, e.clientY), { passive: true });
      track.addEventListener('touchstart', (e) => { const t = e.touches[0]; if (t) arm(t.clientX, t.clientY); }, { passive: true });
      track.addEventListener('touchmove', (e) => { const t = e.touches[0]; if (t) move(t.clientX, t.clientY); }, { passive: true });
      track.addEventListener('click', (e) => {
        if (swiped || Math.abs(track.scrollLeft - startScroll) > 8) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);
    }

  });
</script>


<style>
  /* ==== RECENT WORK SLIDER ====
     Native CSS scroll-snap, not a carousel library. It scrolls with a
     swipe, a trackpad, the arrow keys or the buttons, and it works with
     JavaScript off — so it adds nothing to INP and can't block rendering.
     Every slide is a real <img> with alt text in the server-rendered HTML,
     so all thirteen stay crawlable and eligible for image search. */
  .slider { position: relative; }

  .slider__track {
    display: grid;
    grid-auto-flow: column;
    /* A percentage as the max of minmax() collapses to the min in a
       scrolling grid track, which pinned every slide at 420px. clamp()
       against the viewport gives the intended slide-and-a-half. */
    grid-auto-columns: clamp(280px, 54vw, 760px);
    gap: var(--sp-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    padding-bottom: var(--sp-4);
    /* room for the focus ring, which the overflow would otherwise clip */
    padding-inline: 2px;
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
  }
  .slider__track:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-md);
  }
  .slider__track::-webkit-scrollbar { height: 6px; }
  .slider__track::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: var(--radius-full);
  }

  .slide {
    scroll-snap-align: start;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-inverse);
  }

  .slide__link {
    position: relative;
    display: block;
    color: var(--text-inverse);
    text-decoration: none;
  }
  .slide__link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-lg);
  }

  /* width/height on the img plus this ratio reserves the box before the
     file arrives, so lazy loading can't shift the layout (CLS) */
  .slide img {
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .slide__link:hover img { transform: scale(1.03); }

  /* Caption sits on the photograph. The gradient is tall and opaque enough
     at the base to hold white text over any of the shots — several are
     bright renders, so a light scrim would not have been safe. */
  .slide__caption {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding: var(--sp-8) var(--sp-5) var(--sp-5);
    background: linear-gradient(to top,
      rgba(10, 10, 10, 0.92) 0%,
      rgba(10, 10, 10, 0.72) 42%,
      rgba(10, 10, 10, 0) 100%);
  }

  .slide__service {
    font-size: var(--fs-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--accent-on-dark);
  }

  .slide__title {
    font-size: var(--fs-lg);
    font-weight: var(--weight-semi);
    letter-spacing: var(--tracking-heading);
    line-height: 1.25;
    color: var(--text-inverse);
  }

  .slider__controls {
    display: flex;
    gap: var(--sp-2);
    justify-content: flex-end;
    margin-top: var(--sp-3);
  }
  .slider__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-strong);
    background: var(--surface-raised);
    color: var(--text);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease),
                border-color var(--dur-fast) var(--ease),
                color var(--dur-fast) var(--ease);
  }
  .slider__btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .slider__btn[disabled] { opacity: 0.35; cursor: default; }
  .slider__btn[disabled]:hover {
    background: var(--surface-raised);
    border-color: var(--border-strong);
    color: var(--text);
  }

  @media (max-width: 640px) {
    .slider__track { grid-auto-columns: 86%; }
    .slide__title { font-size: var(--fs-md); }
