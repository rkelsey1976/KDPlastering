---
import PageLayout from '../layouts/PageLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ReviewCards from '../components/ReviewCards.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SERVICES } from '../lib/services';
import { REVIEWS } from '../lib/reviews';

const featuredServices = SERVICES;
const featuredReviews = REVIEWS.slice(0, 3);

// Short price hints for the home page bento cards
const priceHints: Record<string, string> = {
  'silicone-rendering':         '£60/m²',
  'house-rendering':            '£55/m²',
  'external-wall-rendering':    '£55/m²',
  'monocouche-rendering':       '£50/m²',
  'plastering-services':        '£18/m²',
  'external-wall-insulation':   '£120/m²',
};

// Hero photo per service for the bento grid
const serviceImages: Record<string, string> = {
  'silicone-rendering':         '/services/silicone-rendering-hero.jpg',
  'house-rendering':            '/services/house-rendering-hero.jpg',
  'external-wall-rendering':    '/services/ewall-rendering-hero.jpg',
  'monocouche-rendering':       '/services/monocouche-rendering-hero.jpg',
  'plastering-services':        '/services/plastering-hero.jpg',
  'external-wall-insulation':   '/services/ewi-hero.jpg',
};

// Gallery photos for the "Recent work" section
const galleryImages = [
  { src: '/services/silicone-rendering-1.jpg', caption: 'Silicone render, Hanham' },
  { src: '/services/monocouche-rendering-2.jpg', caption: 'Monocouche render, Bathwick' },
  { src: '/services/ewi-1.jpg',                caption: 'EWI installation, Kingswood' },
  { src: '/services/plastering-1.jpg',         caption: 'Internal plastering, Fishponds' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'Plasterer'],
  name: 'KD Plastering & Rendering Services',
  '@id': 'https://www.kdplasteringrenderingservices.co.uk/#organization',
  telephone: '+441174094116',
  email: 'kdplasteringltd@gmail.com',
  url: 'https://www.kdplasteringrenderingservices.co.uk',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '8 Roman Way, Hanham',
    addressLocality: 'Bristol',
    postalCode: 'BS15 3FH',
    addressCountry: 'GB',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 51.4486,
    longitude: -2.5107,
  },
  areaServed: [
    { '@type': 'City', name: 'Bristol' },
    { '@type': 'City', name: 'Bath' },
  ],
  priceRange: '££',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '18:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '09:00',
      closes: '13:00',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '180',
    bestRating: '5',
  },
};
---

<PageLayout
  title="Bristol's Trusted Plastering & Rendering Specialists | KD Plastering"
  description="Professional plastering, rendering and external wall insulation across Bristol and Bath. 10+ years experience, fully insured, 180+ verified reviews. Free quotes within 48 hours."
  canonical="/"
  schema={schema}
  showLeadForm={true}
  formHeading="Get Your Free Bristol & Bath Quote"
>
  <!-- 1. HERO — bold black + orange, single signature moment -->
  <section class="hero hero--bold">
    <!-- Full-bleed background photo -->
    <div class="hero__bg" aria-hidden="true">
      <div class="hero__bg-img" style="background-image: url('/hero-home.webp')"></div>
      <div class="hero__bg-overlay"></div>
    </div>

    <div class="container hero__container">
      <div class="hero__inner">
        <div class="hero__eyebrow">
          <span class="hero__eyebrow-bar"></span>
          <span>Bristol &amp; Bath Plastering Specialists</span>
          <span class="hero__eyebrow-dot"></span>
          <span>Since 2014</span>
        </div>

        <h1 class="hero__title">
          We transform Bristol homes<br />
          with a render that <span class="hero__title-accent">lasts 25 years.</span>
        </h1>

        <p class="hero__lede">
          Silicone render, monocouche, house rendering and external wall insulation &mdash; fitted by Bristol's most reviewed plastering team.
        </p>

        <div class="hero__cta-row">
          <a href="#quote" class="hero__cta-primary">
            <span>Get Your Free Quote</span>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="tel:01174094116" class="hero__cta-secondary">
            <span class="hero__cta-secondary-label">or call</span>
            <span class="hero__cta-secondary-num">0117 409 4116</span>
          </a>
        </div>

        <!-- Trust signals live in the orange statbar below — no duplicate strip here -->
      </div>
    </div>

    <!-- Diagonal orange stat strip — runs across the bottom edge -->
    <div class="hero__statbar" aria-label="KD Plastering at a glance">
      <div class="hero__statbar-track">
        <div class="hero__statbar-cell">
          <span class="hero__statbar-num" data-count="10" data-suffix="+">10+</span>
          <span class="hero__statbar-label">Years in Bristol</span>
        </div>
        <div class="hero__statbar-cell">
          <span class="hero__statbar-num" data-count="180" data-suffix="+">180+</span>
          <span class="hero__statbar-label">5-Star Reviews</span>
        </div>
        <div class="hero__statbar-cell">
          <span class="hero__statbar-num" data-count="20">20</span>
          <span class="hero__statbar-label">Areas Covered</span>
        </div>
        <div class="hero__statbar-cell">
          <span class="hero__statbar-num" data-count="800" data-suffix="+">800+</span>
          <span class="hero__statbar-label">Projects Done</span>
        </div>
        <div class="hero__statbar-cell">
          <span class="hero__statbar-num" data-count="25" data-suffix=" yr">25 yr</span>
          <span class="hero__statbar-label">System Warranty</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. SERVICES — 6 cards, uniform grid -->
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="What we do"
        eyebrowVariant="clay"
        heading="Our services"
        lede="Every type of internal plastering, external rendering and external wall insulation across Bristol &amp; Bath."
      />
      <div class="service-grid reveal-stagger">
        {featuredServices.map((service, i) => (
          <ServiceCard
            slug={service.slug}
            shortName={service.shortName}
            tagline={service.tagline}
            priceHint={priceHints[service.slug]}
            imageSrc={serviceImages[service.slug]}
            number={String(i + 1).padStart(2, '0')}
            variant="default"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 3. PROJECT GALLERY — visual proof -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        eyebrow="Recent work"
        eyebrowVariant="clay"
        heading="Recent projects across Bristol &amp; Bath"
        lede="A selection of recent rendering and plastering projects."
      />
      <div class="gallery-grid">
        {galleryImages.map((img) => (
          <figure class="gallery-card">
            <div class="gallery-card__img" role="img" aria-label={img.caption} style={`background-image: url('${img.src}')`}></div>
            <figcaption>{img.caption}</figcaption>
          </figure>
        ))}
      </div>
      <div class="gallery-cta">
        <a href="/our-work/" class="btn btn--ghost">See more of our work</a>
      </div>
    </div>
  </section>

  <!-- 4. REVIEWS + TRUST — combined trust block -->
  <section class="section">
    <div class="container">
      <ReviewCards
        reviews={featuredReviews}
        heading="What Bristol &amp; Bath homeowners say"
        lede="Three of our most recent verified reviews."
      />

      <!-- BBA / manufacturer row -->
      <div class="trust-row">
        <p class="trust-row__heading">BBA-approved installer for:</p>
        <ul class="trust-row__logos">
          <li><strong>Johnstone's</strong> Stormshield</li>
          <li><strong>K Rend</strong></li>
          <li><strong>Parex</strong></li>
          <li><strong>Weber</strong> EWI Systems</li>
        </ul>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  // Scroll reveal animations
  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Skip animations — make everything visible immediately
      document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => el.classList.add('is-visible'));
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.05, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => observer.observe(el));

    // Animated stat counters
    const stats = document.querySelectorAll('.hero__statbar-num');
    const statObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target;
        const target = parseInt(el.dataset.count || '0', 10);
        const prefix = el.dataset.prefix || '';
        const suffix = el.dataset.suffix || '';
        const duration = 1500;
        const start = performance.now();
        const animate = (now) => {
          const t = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          const value = Math.floor(eased * target);
          el.textContent = `${prefix}${value}${suffix}`;
          if (t < 1) requestAnimationFrame(animate);
          else el.textContent = `${prefix}${target}${suffix}`;
        };
        requestAnimationFrame(animate);
        statObserver.unobserve(el);
      });
    }, { threshold: 0.5 });
    stats.forEach((el) => statObserver.observe(el));
  });
</script>

<style is:global>
/* ==== SCROLL REVEAL ANIMATIONS ==== */
  @media (prefers-reduced-motion: no-preference) {
    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    .reveal-stagger > * {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal-stagger.is-visible > * {
      opacity: 1;
      transform: translateY(0);
    }
    .reveal-stagger.is-visible > *:nth-child(1) { transition-delay: 0.05s; }
    .reveal-stagger.is-visible > *:nth-child(2) { transition-delay: 0.12s; }
    .reveal-stagger.is-visible > *:nth-child(3) { transition-delay: 0.19s; }
    .reveal-stagger.is-visible > *:nth-child(4) { transition-delay: 0.26s; }
    .reveal-stagger.is-visible > *:nth-child(5) { transition-delay: 0.33s; }
    .reveal-stagger.is-visible > *:nth-child(6) { transition-delay: 0.40s; }
  }

  /* ==== UNIFORM CARD GRID (3-col desktop, 2-col tablet, 1-col mobile) ==== */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-5);
  }

  @media (max-width: 900px) {
    .service-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-4);
    }
  }

  @media (max-width: 600px) {
    .service-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
<style>
  /* Gallery */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-4);
  }
  @media (max-width: 900px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .gallery-card {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--color-border);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .gallery-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .gallery-card__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-size: cover;
    background-position: center;
    background-color: var(--color-stone);
  }
  .gallery-card figcaption {
    padding: var(--sp-3) var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--color-walnut-muted);
    border-top: 1px solid var(--color-border);
  }
  .gallery-cta {
    margin-top: var(--sp-5);
    text-align: center;
  }

  /* Trust row — manufacturer logos */
  .trust-row {
    margin-top: var(--sp-7);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }
  .trust-row__heading {
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-walnut-muted);
    font-weight: 700;
  }
  .trust-row__logos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3) var(--sp-6);
    font-size: var(--fs-sm);
    color: var(--color-walnut-muted);
  }
  .trust-row__logos li {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .trust-row__logos strong {
    color: var(--color-walnut);
    font-weight: 700;
  }
</style>
