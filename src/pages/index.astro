---
import PageLayout from '../layouts/PageLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ReviewCards from '../components/ReviewCards.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SERVICES } from '../lib/services';
import { REVIEWS } from '../lib/reviews';

const featuredServices = SERVICES;
const featuredReviews = REVIEWS.slice(0, 3);

// Short price hints for the home page bento cards
const priceHints: Record<string, string> = {
  'silicone-rendering':         '£60/m²',
  'house-rendering':            '£55/m²',
  'external-wall-rendering':    '£55/m²',
  'monocouche-rendering':       '£50/m²',
  'plastering-services':        '£18/m²',
  'external-wall-insulation':   '£120/m²',
};

// Hero photo per service for the bento grid
const serviceImages: Record<string, string> = {
  'silicone-rendering':         '/services/silicone-rendering-hero.jpg',
  'house-rendering':            '/services/house-rendering-hero.jpg',
  'external-wall-rendering':    '/services/ewall-rendering-hero.jpg',
  'monocouche-rendering':       '/services/monocouche-rendering-hero.jpg',
  'plastering-services':        '/services/plastering-hero.jpg',
  'external-wall-insulation':   '/services/ewi-hero.jpg',
};

// Gallery photos for the "Recent work" section
const galleryImages = [
  { src: '/services/silicone-rendering-1.jpg', caption: 'Silicone render, Hanham' },
  { src: '/services/monocouche-rendering-2.jpg', caption: 'Monocouche render, Bathwick' },
  { src: '/services/ewi-1.jpg',                caption: 'EWI installation, Kingswood' },
  { src: '/services/plastering-1.jpg',         caption: 'Internal plastering, Fishponds' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'Plasterer'],
  name: 'KD Plastering & Rendering Services',
  '@id': 'https://www.kdplasteringrenderingservices.co.uk/#organization',
  telephone: '+441174094116',
  email: 'kdplasteringltd@gmail.com',
  url: 'https://www.kdplasteringrenderingservices.co.uk',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '8 Roman Way, Hanham',
    addressLocality: 'Bristol',
    postalCode: 'BS15 3FH',
    addressCountry: 'GB',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 51.4486,
    longitude: -2.5107,
  },
  areaServed: [
    { '@type': 'City', name: 'Bristol' },
    { '@type': 'City', name: 'Bath' },
  ],
  priceRange: '££',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '18:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '09:00',
      closes: '13:00',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '180',
    bestRating: '5',
  },
};
---

<PageLayout
  title="Bristol's Trusted Plastering & Rendering Specialists | KD Plastering"
  description="Professional plastering, rendering and external wall insulation across Bristol and Bath. 10+ years experience, fully insured, 180+ verified reviews. Free quotes within 48 hours."
  canonical="/"
  schema={schema}
  showLeadForm={true}
  formHeading="Get Your Free Bristol & Bath Quote"
>
  <!-- 1. HERO — what, where, primary CTA, trust signals -->
  <section class="hero hero--image">
    <div class="container">
      <div class="hero__eyebrow">Bristol &amp; Bath Plastering Specialists</div>
      <h1 class="hero__title">Plastering &amp; Rendering Services across Bristol &amp; Bath</h1>
      <p class="hero__lede">
        Silicone render, monocouche, house rendering, external wall insulation and internal plastering &mdash; fitted by BBA-approved installers with a 10-year warranty. Free site visit. Fixed written quote within 48 hours.
      </p>
      <div class="hero__cta-row">
        <a href="#lead-form-heading" class="btn btn--primary btn--lg">Get a Free Quote</a>
        <a href="tel:01174094116" class="btn btn--ghost-light btn--lg">Call 0117 409 4116</a>
      </div>
      <div class="hero__trust-bar">
        <span class="hero__trust-item">✓ 10+ Years Experience</span>
        <span class="hero__trust-item">✓ 180+ Verified Reviews</span>
        <span class="hero__trust-item">✓ £2m Public Liability</span>
        <span class="hero__trust-item">✓ 10-Year Manufacturer Warranty</span>
      </div>
    </div>
  </section>

  <!-- 2. SERVICES — 6 cards, bento grid -->
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="What we do"
        eyebrowVariant="clay"
        heading="Our services"
        lede="Every type of internal plastering, external rendering and external wall insulation across Bristol &amp; Bath."
      />
      <div class="service-bento">
        {featuredServices.map((service, i) => {
          // Layout: 1 large + 1 medium, 3 small, 1 wide
          let cardVariant = 'bento';
          if (i === 0) cardVariant = 'bento-lg';          // Silicone — hero
          else if (i === 5) cardVariant = 'featured';     // EWI — wide row
          else if (i === 1) cardVariant = 'featured';     // House — medium

          return (
            <ServiceCard
              slug={service.slug}
              shortName={service.shortName}
              tagline={service.tagline}
              longTagline={service.longIntro}
              priceHint={priceHints[service.slug]}
              imageSrc={serviceImages[service.slug]}
              number={String(i + 1).padStart(2, '0')}
              variant={cardVariant}
            />
          );
        })}
      </div>
    </div>
  </section>

  <!-- 3. PROJECT GALLERY — visual proof -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        eyebrow="Recent work"
        eyebrowVariant="clay"
        heading="Recent projects across Bristol &amp; Bath"
        lede="A selection of recent rendering and plastering projects."
      />
      <div class="gallery-grid">
        {galleryImages.map((img) => (
          <figure class="gallery-card">
            <div class="gallery-card__img" role="img" aria-label={img.caption} style={`background-image: url('${img.src}')`}></div>
            <figcaption>{img.caption}</figcaption>
          </figure>
        ))}
      </div>
      <div class="gallery-cta">
        <a href="/our-work/" class="btn btn--ghost">See more of our work</a>
      </div>
    </div>
  </section>

  <!-- 4. REVIEWS + TRUST — combined trust block -->
  <section class="section">
    <div class="container">
      <ReviewCards
        reviews={featuredReviews}
        heading="What Bristol &amp; Bath homeowners say"
        lede="Three of our most recent verified reviews."
      />

      <!-- BBA / manufacturer row -->
      <div class="trust-row">
        <p class="trust-row__heading">BBA-approved installer for:</p>
        <ul class="trust-row__logos">
          <li><strong>Johnstone's</strong> Stormshield</li>
          <li><strong>K Rend</strong></li>
          <li><strong>Parex</strong></li>
          <li><strong>Weber</strong> EWI Systems</li>
        </ul>
      </div>
    </div>
  </section>
</PageLayout>

<style is:global>
  /* ==== BENTO SERVICE GRID ==== */
  .service-bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: minmax(160px, auto);
    gap: var(--sp-4);
  }

  /* Place each card by index — use direct child selector for portability */
  .service-bento > a:nth-of-type(1) {
    grid-column: span 4;
    grid-row: span 2;
  }   /* Silicone — large hero */
  .service-bento > a:nth-of-type(2) {
    grid-column: span 2;
    grid-row: span 2;
  }   /* House — medium */
  .service-bento > a:nth-of-type(3) {
    grid-column: span 2;
  }   /* External wall — small */
  .service-bento > a:nth-of-type(4) {
    grid-column: span 2;
  }   /* Monocouche — small */
  .service-bento > a:nth-of-type(5) {
    grid-column: span 2;
  }   /* Plastering — small */
  .service-bento > a:nth-of-type(6) {
    grid-column: span 6;
  }   /* EWI — full width */

  @media (max-width: 900px) {
    .service-bento {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
    .service-bento > a {
      grid-column: span 1 !important;
      grid-row: auto !important;
    }
  }
</style>
<style>
  /* Gallery */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-4);
  }
  @media (max-width: 900px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .gallery-card {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--color-border);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .gallery-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .gallery-card__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-size: cover;
    background-position: center;
    background-color: var(--color-stone);
  }
  .gallery-card figcaption {
    padding: var(--sp-3) var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--color-walnut-muted);
    border-top: 1px solid var(--color-border);
  }
  .gallery-cta {
    margin-top: var(--sp-5);
    text-align: center;
  }

  /* Trust row — manufacturer logos */
  .trust-row {
    margin-top: var(--sp-7);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }
  .trust-row__heading {
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-walnut-muted);
    font-weight: 700;
  }
  .trust-row__logos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3) var(--sp-6);
    font-size: var(--fs-sm);
    color: var(--color-walnut-muted);
  }
  .trust-row__logos li {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .trust-row__logos strong {
    color: var(--color-walnut);
    font-weight: 700;
  }
</style>
