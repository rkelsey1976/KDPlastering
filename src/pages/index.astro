---
import PageLayout from '../layouts/PageLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ReviewCards from '../components/ReviewCards.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Hero from '../components/Hero.astro';
import { SERVICES } from '../lib/services';
import { REVIEWS } from '../lib/reviews';

const featuredServices = SERVICES;
const featuredReviews = REVIEWS.slice(0, 3);

const heroStats = [
  { value: 10,  suffix: '+',   label: 'Years in Bristol' },
  { value: 180, suffix: '+',   label: '5-Star Reviews' },
  { value: 20,                 label: 'Areas Covered' },
  { value: 800, suffix: '+',   label: 'Projects Done' },
  { value: 25,  suffix: ' yr', label: 'System Warranty' },
];

// Hero photo per service for the bento grid
// Card-sized WebP (760x475), not the full 1600px heroes. The grid was
// pulling 2.17MB of JPEG to fill six ~380px cards.
const serviceImages: Record<string, string> = {
  'silicone-rendering':         '/services/cards/silicone-rendering.webp',
  'house-rendering':            '/services/cards/house-rendering.webp',
  'external-wall-rendering':    '/services/cards/ewall-rendering.webp',
  'monocouche-rendering':       '/services/cards/monocouche-rendering.webp',
  'plastering-services':        '/services/cards/plastering.webp',
  'external-wall-insulation':   '/services/cards/ewi.webp',
};

// Gallery photos for the "Recent work" section
// Captions describe what is actually in each frame (see
// public/services/MANIFEST.md) rather than inventing locations.
// Each slide links to the service it demonstrates — real project photos
// become internal links to the pages that need them.
const galleryImages = [
  { src: '/services/gallery/ewall-rendering-1.webp',      slug: 'external-wall-rendering',  service: 'External Wall Rendering', caption: 'Spraying monocouche render',            alt: 'KD Plastering applying sprayed cream monocouche render to a house exterior' },
  { src: '/services/gallery/silicone-rendering-2.webp',   slug: 'silicone-rendering',       service: 'Silicone Rendering',      caption: 'Smooth silicone render, new build',      alt: 'New-build home finished in smooth off-white silicone render with anthracite cladding' },
  { src: '/services/gallery/ewi-1.webp',                  slug: 'external-wall-insulation', service: 'External Wall Insulation', caption: 'External wall insulation going on',     alt: 'EPS insulation boards being mechanically fixed to an external wall' },
  { src: '/services/gallery/monocouche-rendering-2.webp', slug: 'monocouche-rendering',     service: 'Monocouche Rendering',    caption: 'Traditional detached, finished',         alt: 'Large traditional detached house finished in cream monocouche render' },
  { src: '/services/gallery/ewall-rendering-2.webp',      slug: 'external-wall-rendering',  service: 'External Wall Rendering', caption: 'Trowel finish, close up',                alt: 'Close-up of a steel trowel smoothing cream render' },
  { src: '/services/gallery/house-rendering-1.webp',      slug: 'house-rendering',          service: 'House Rendering',         caption: 'Rear elevation, render and dormer',      alt: 'Rear elevation with render, timber dormer and bi-fold doors' },
  { src: '/services/gallery/plastering-1.webp',           slug: 'plastering-services',      service: 'Plastering',              caption: 'Internal plastering, finished',          alt: 'Finished interior room with smooth white plastered walls' },
  { src: '/services/gallery/monocouche-rendering-1.webp', slug: 'monocouche-rendering',     service: 'Monocouche Rendering',    caption: 'Textured render, hand applied',          alt: 'Applying textured beige render with a steel trowel' },
  { src: '/services/gallery/ewi-2.webp',                  slug: 'external-wall-insulation', service: 'External Wall Insulation', caption: 'Completed EWI and render',              alt: 'Completed cream rendered home following external wall insulation' },
  { src: '/services/gallery/house-rendering-3.webp',      slug: 'house-rendering',          service: 'House Rendering',         caption: 'Detached front, smooth render',          alt: 'Front of a detached house in smooth off-white render with a bow bay window' },
  { src: '/services/gallery/ewall-rendering-3.webp',      slug: 'external-wall-rendering',  service: 'External Wall Rendering', caption: 'Finished in cream render',               alt: 'Finished house front in cream render' },
  { src: '/services/gallery/silicone-rendering-1.webp',   slug: 'silicone-rendering',       service: 'Silicone Rendering',      caption: 'Silicone render, colour finish',         alt: 'Mustard yellow silicone render with a charcoal accent panel' },
  { src: '/services/gallery/monocouche-rendering-3.webp', slug: 'monocouche-rendering',     service: 'Monocouche Rendering',    caption: 'White render, bay window',               alt: 'Semi-detached house in white render with a bay window' },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'Plasterer'],
  name: 'KD Plastering & Rendering Services',
  '@id': 'https://www.kdplasteringrenderingservices.co.uk/#organization',
  telephone: '+441174094116',
    contactPoint: [
      {
        '@type': 'ContactPoint',
        telephone: '+441174094116',
        contactType: 'customer service',
        areaServed: 'GB',
        availableLanguage: 'English',
      },
      {
        '@type': 'ContactPoint',
        telephone: '+447961114662',
        contactType: 'customer service',
        areaServed: 'GB',
        availableLanguage: 'English',
      },
    ],
  email: 'kdplasteringltd@gmail.com',
  url: 'https://www.kdplasteringrenderingservices.co.uk',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '8 Roman Way, Hanham',
    addressLocality: 'Bristol',
    postalCode: 'BS15 3FH',
    addressCountry: 'GB',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 51.4486,
    longitude: -2.5107,
  },
  areaServed: [
    { '@type': 'City', name: 'Bristol' },
    { '@type': 'City', name: 'Bath' },
  ],
  priceRange: '££',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '18:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '09:00',
      closes: '13:00',
    },
  ],
};
---

<PageLayout
  title="Bristol's Trusted Plastering & Rendering Specialists | KD Plastering"
  description="Professional plastering, rendering and external wall insulation across Bristol and Bath. 10+ years experience, fully insured, 4.9 on Google from 50 reviews. Free quotes within 48 hours."
  canonical="/"
  schema={schema}
>
  <Hero
    eyebrow={['Bristol & Bath Plastering Specialists', 'Since 2014']}
    title="We transform Bristol homes with a render that"
    titleAccent="lasts 25 years."
    lede="Silicone render, monocouche, house rendering and external wall insulation — fitted by Bristol's most reviewed plastering team."
    primaryCta={{ label: 'Get Your Free Quote', href: '/contact/#lead-form-heading' }}
    phone={{ number: '01174094116', display: '0117 409 4116' }}
    image="/hero-home.webp"
    rotateWith={['/hero-2.webp', '/hero-3.webp', '/hero-4.webp']}
    stats={heroStats}
  />

  <!-- 2. SERVICES — 6 cards, uniform grid -->
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="What we do"
                heading="Our services"
        lede="Every type of internal plastering, external rendering and external wall insulation across Bristol & Bath."
      />
      <div class="service-grid reveal-stagger">
        {featuredServices.map((service, i) => (
          <ServiceCard
            slug={service.slug}
            shortName={service.shortName}
            tagline={service.tagline}
            imageSrc={serviceImages[service.slug]}
            number={String(i + 1).padStart(2, '0')}
            variant="default"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 3. PROJECT GALLERY — visual proof -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        eyebrow="Recent work"
                heading="Recent projects across Bristol & Bath"
        lede="A selection of recent rendering and plastering projects."
      />
      <div class="slider">
        <div class="slider__track" id="work-slider" tabindex="0" role="region"
             aria-label="Recent projects — scrollable">
          {galleryImages.map((img, i) => (
            <figure class="slide">
              <a
                href={`/our-services/${img.slug}-bristol/`}
                class="slide__link"
                aria-label={`${img.service}: ${img.caption}`}
              >
                <img
                  src={img.src}
                  alt={img.alt}
                  width="920"
                  height="613"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                <figcaption class="slide__caption">
                  <span class="slide__service">{img.service}</span>
                  <span class="slide__title">{img.caption}</span>
                </figcaption>
              </a>
            </figure>
          ))}
        </div>

        <div class="slider__controls">
          <button type="button" class="slider__btn" data-dir="-1" aria-controls="work-slider" aria-label="Previous projects">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" class="slider__btn" data-dir="1" aria-controls="work-slider" aria-label="More projects">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>
      <div class="gallery-cta">
        <a href="/our-work/" class="btn btn--ghost">See more of our work</a>
      </div>
    </div>
  </section>

  <!-- 4. REVIEWS + TRUST — combined trust block -->
  <section class="section">
    <div class="container">
      <ReviewCards
        reviews={featuredReviews}
        heading="What Bristol & Bath homeowners say"
        lede="Three of our most recent verified reviews."
      />

      <!-- BBA / manufacturer row -->
      <div class="trust-row">
        <p class="trust-row__heading">BBA-approved installer for:</p>
        <ul class="trust-row__logos">
          <li><strong>Johnstone's</strong> Stormshield</li>
          <li><strong>K Rend</strong></li>
          <li><strong>Parex</strong></li>
          <li><strong>Weber</strong> EWI Systems</li>
        </ul>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  // Scroll reveal animations
  document.addEventListener('DOMContentLoaded', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Skip animations — make everything visible immediately
      document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => el.classList.add('is-visible'));
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.05, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => observer.observe(el));

    // Recent-work slider — enhancement only. The track already scrolls by
    // swipe, trackpad and arrow keys with no JS; this just wires the
    // buttons and greys them out at each end.
    const track = document.getElementById('work-slider');
    if (track) {
      const step = () => {
        const slide = track.querySelector('.slide');
        return slide ? slide.getBoundingClientRect().width + 16 : track.clientWidth * 0.8;
      };
      const buttons = document.querySelectorAll('.slider__btn');
      const sync = () => {
        // The track has 2px of inline padding for the focus ring, and snap
        // points land on sub-pixel offsets, so scrollLeft never settles at
        // exactly 0 or exactly max. Without this tolerance the buttons
        // never grey out at either end.
        const EDGE = 6;
        const max = track.scrollWidth - track.clientWidth;
        buttons.forEach((b) => {
          const dir = Number(b.getAttribute('data-dir'));
          b.toggleAttribute(
            'disabled',
            dir < 0 ? track.scrollLeft <= EDGE : track.scrollLeft >= max - EDGE
          );
        });
      };
      buttons.forEach((b) => b.addEventListener('click', () => {
        track.scrollBy({ left: Number(b.getAttribute('data-dir')) * step(), behavior: 'smooth' });
      }));
      track.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync, { passive: true });
      sync();
    }

  });
</script>


<style>
  /* ==== RECENT WORK SLIDER ====
     Native CSS scroll-snap, not a carousel library. It scrolls with a
     swipe, a trackpad, the arrow keys or the buttons, and it works with
     JavaScript off — so it adds nothing to INP and can't block rendering.
     Every slide is a real <img> with alt text in the server-rendered HTML,
     so all thirteen stay crawlable and eligible for image search. */
  .slider { position: relative; }

  .slider__track {
    display: grid;
    grid-auto-flow: column;
    /* A percentage as the max of minmax() collapses to the min in a
       scrolling grid track, which pinned every slide at 420px. clamp()
       against the viewport gives the intended slide-and-a-half. */
    grid-auto-columns: clamp(280px, 54vw, 760px);
    gap: var(--sp-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    padding-bottom: var(--sp-4);
    /* room for the focus ring, which the overflow would otherwise clip */
    padding-inline: 2px;
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
  }
  .slider__track:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-md);
  }
  .slider__track::-webkit-scrollbar { height: 6px; }
  .slider__track::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: var(--radius-full);
  }

  .slide {
    scroll-snap-align: start;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-inverse);
  }

  .slide__link {
    position: relative;
    display: block;
    color: var(--text-inverse);
    text-decoration: none;
  }
  .slide__link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-lg);
  }

  /* width/height on the img plus this ratio reserves the box before the
     file arrives, so lazy loading can't shift the layout (CLS) */
  .slide img {
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .slide__link:hover img { transform: scale(1.03); }

  /* Caption sits on the photograph. The gradient is tall and opaque enough
     at the base to hold white text over any of the shots — several are
     bright renders, so a light scrim would not have been safe. */
  .slide__caption {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding: var(--sp-8) var(--sp-5) var(--sp-5);
    background: linear-gradient(to top,
      rgba(10, 10, 10, 0.92) 0%,
      rgba(10, 10, 10, 0.72) 42%,
      rgba(10, 10, 10, 0) 100%);
  }

  .slide__service {
    font-size: var(--fs-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--accent-on-dark);
  }

  .slide__title {
    font-size: var(--fs-lg);
    font-weight: var(--weight-semi);
    letter-spacing: var(--tracking-heading);
    line-height: 1.25;
    color: var(--text-inverse);
  }

  .slider__controls {
    display: flex;
    gap: var(--sp-2);
    justify-content: flex-end;
    margin-top: var(--sp-3);
  }
  .slider__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-strong);
    background: var(--surface-raised);
    color: var(--text);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease),
                border-color var(--dur-fast) var(--ease),
                color var(--dur-fast) var(--ease);
  }
  .slider__btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .slider__btn[disabled] { opacity: 0.35; cursor: default; }
  .slider__btn[disabled]:hover {
    background: var(--surface-raised);
    border-color: var(--border-strong);
    color: var(--text);
  }

  @media (max-width: 640px) {
    .slider__track { grid-auto-columns: 86%; }
    .slide__title { font-size: var(--fs-md); }
    .slide__caption { padding: var(--sp-7) var(--sp-4) var(--sp-4); }
    .slider__controls { justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .slider__track { scroll-behavior: auto; }
  }

</style>
<style is:global>
/* ==== SCROLL REVEAL ANIMATIONS ==== */
  @media (prefers-reduced-motion: no-preference) {
    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    .reveal-stagger > * {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal-stagger.is-visible > * {
      opacity: 1;
      transform: translateY(0);
    }
    .reveal-stagger.is-visible > *:nth-child(1) { transition-delay: 0.05s; }
    .reveal-stagger.is-visible > *:nth-child(2) { transition-delay: 0.12s; }
    .reveal-stagger.is-visible > *:nth-child(3) { transition-delay: 0.19s; }
    .reveal-stagger.is-visible > *:nth-child(4) { transition-delay: 0.26s; }
    .reveal-stagger.is-visible > *:nth-child(5) { transition-delay: 0.33s; }
    .reveal-stagger.is-visible > *:nth-child(6) { transition-delay: 0.40s; }
  }

  /* ==== UNIFORM CARD GRID (3-col desktop, 2-col tablet, 1-col mobile) ==== */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-5);
  }

  @media (max-width: 900px) {
    .service-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-4);
    }
  }

  @media (max-width: 600px) {
    .service-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
<style>
  /* Gallery */
  @media (max-width: 900px) {
  }

  .gallery-card {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--border);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .gallery-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .gallery-card__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-size: cover;
    background-position: center;
    background-color: var(--border);
  }
  .gallery-card figcaption {
    padding: var(--sp-3) var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    border-top: 1px solid var(--border);
  }
  .gallery-cta {
    margin-top: var(--sp-5);
    text-align: center;
  }

  /* Trust row — manufacturer logos */
  .trust-row {
    margin-top: var(--sp-7);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--border);
    text-align: center;
  }
  .trust-row__heading {
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    font-weight: 700;
  }
  .trust-row__logos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3) var(--sp-6);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  .trust-row__logos li {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .trust-row__logos strong {
    color: var(--text);
    font-weight: 700;
  }
</style>
