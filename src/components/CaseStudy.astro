---
// CaseStudy component — renders a single, large-format case study
// block with before/after, problem/solution, duration, cost, and result.
// Used on service city hubs.

export type CaseStudy = {
  title: string;
  location: string;
  propertyType: string;
  problem: string;
  solution: string;
  duration: string;
  costRange: string;
  result: string;
  beforeAlt: string;
  afterAlt: string;
};

type Props = {
  caseStudy: CaseStudy;
  areaName?: string;
};

const { caseStudy, areaName } = Astro.props as Props;
---

<aside class="case-study" aria-labelledby="case-study-heading">
  <div class="case-study-header">
    <span class="case-study-badge">Real Project</span>
    <h2 id="case-study-heading" class="case-study-title">{caseStudy.title}</h2>
  </div>

  <div class="case-study-meta">
    {areaName && <span class="case-study-tag">📍 {areaName}</span>}
    <span class="case-study-tag">🏠 {caseStudy.propertyType}</span>
    <span class="case-study-tag">⏱ {caseStudy.duration}</span>
    <span class="case-study-tag">💷 {caseStudy.costRange}</span>
  </div>

  <div class="case-study-grid">
    <div>
      <h3 class="case-study-step-heading">The Problem</h3>
      <p>{caseStudy.problem}</p>
    </div>
    <div>
      <h3 class="case-study-step-heading">Our Solution</h3>
      <p>{caseStudy.solution}</p>
    </div>
  </div>

  <div class="case-study-images" aria-label="Before and after">
    <figure class="case-study-figure">
      <div class="case-study-image case-study-image--before" aria-label={caseStudy.beforeAlt} role="img"></div>
      <figcaption><strong>Before:</strong> {caseStudy.beforeAlt}</figcaption>
    </figure>
    <figure class="case-study-figure">
      <div class="case-study-image case-study-image--after" aria-label={caseStudy.afterAlt} role="img"></div>
      <figcaption><strong>After:</strong> {caseStudy.afterAlt}</figcaption>
    </figure>
  </div>

  <div class="case-study-result">
    <h3 class="case-study-step-heading">The Result</h3>
    <p>{caseStudy.result}</p>
  </div>
</aside>

<style>
  .case-study {
    background: linear-gradient(180deg, #fff 0%, var(--color-slate-light) 100%);
    border: 1px solid var(--color-stone-deep);
    border-radius: 8px;
    padding: 2rem;
    margin: 3rem 0;
    box-shadow: 0 4px 16px rgba(0,0,0,0.04);
  }
  .case-study-header {
    margin-bottom: 1rem;
  }
  .case-study-badge {
    display: inline-block;
    background: var(--color-slate);
    color: #fff;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .case-study-title {
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0 0 1rem;
    color: var(--color-ink);
    line-height: 1.3;
  }
  .case-study-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .case-study-tag {
    background: #fff;
    border: 1px solid var(--color-stone-deep);
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }
  .case-study-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }
  .case-study-step-heading {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: var(--color-slate);
  }
  .case-study-images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .case-study-figure {
    margin: 0;
  }
  .case-study-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 4px;
    margin-bottom: 0.5rem;
    background-color: #ddd;
    background-size: cover;
    background-position: center;
  }
  .case-study-image--before {
    background-image: linear-gradient(135deg, #8a8a8a 0%, #b3b3b3 100%);
  }
  .case-study-image--after {
    background-image: linear-gradient(135deg, var(--color-slate) 0%, var(--color-fern) 100%);
  }
  .case-study-figure figcaption {
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    line-height: 1.4;
  }
  .case-study-result {
    background: #fff;
    border-left: 4px solid var(--color-fern);
    padding: 1rem 1.25rem;
    border-radius: 0 4px 4px 0;
    margin-top: 1rem;
  }
  @media (max-width: 700px) {
    .case-study-grid,
    .case-study-images {
      grid-template-columns: 1fr;
    }
  }
</style>
