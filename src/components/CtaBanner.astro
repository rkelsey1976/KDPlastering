---
// CTA banner — high-contrast strip used mid-page to drive conversion
type Props = {
  heading: string;
  body?: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  variant?: 'slate' | 'terracotta' | 'render';
};

const {
  heading,
  body,
  primaryCta,
  secondaryCta,
  variant = 'slate',
} = Astro.props as Props;
---

<section class={`cta-banner cta-banner--${variant}`}>
  <div class="container">
    <div class="cta-banner__inner">
      <div class="cta-banner__copy">
        <h2>{heading}</h2>
        {body && <p>{body}</p>}
      </div>
      <div class="cta-banner__actions">
        <a href={primaryCta.href} class:list={['btn', variant === 'render' ? 'btn--primary' : 'btn--primary']}>
          {primaryCta.label}
        </a>
        {secondaryCta && (
          <a href={secondaryCta.href} class="btn btn--ghost-light">
            {secondaryCta.label}
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    padding: var(--sp-7) 0;
    position: relative;
  }

  .cta-banner--slate {
    background: linear-gradient(135deg, var(--color-walnut) 0%, #2a1f12 100%);
    color: var(--color-cream);
  }

  .cta-banner--slate::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 25% 50%, rgba(162, 93, 47, 0.08) 0%, transparent 45%),
      radial-gradient(circle at 80% 30%, rgba(90, 122, 82, 0.08) 0%, transparent 45%);
    pointer-events: none;
  }

  .cta-banner--terracotta {
    background: linear-gradient(135deg, var(--color-clay) 0%, var(--color-clay-deep) 100%);
    color: #fff;
  }

  .cta-banner--render {
    background: var(--color-cream-deep);
    color: var(--color-walnut);
    border-top: 1px solid var(--color-render-deep);
    border-bottom: 1px solid var(--color-render-deep);
  }

  .cta-banner--render h2 { color: var(--color-walnut); }
  .cta-banner--render p { color: var(--color-walnut-muted); }
  .cta-banner--render .btn--ghost-light {
    color: var(--color-walnut);
    border-color: var(--color-border-strong);
  }
  .cta-banner--render .btn--ghost-light:hover {
    background: var(--color-stone);
    border-color: var(--color-walnut);
    color: var(--color-walnut);
  }

  .cta-banner__inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-5);
    align-items: center;
    justify-content: space-between;
  }

  .cta-banner__copy {
    flex: 1 1 320px;
  }

  .cta-banner__copy h2 {
    margin: 0 0 var(--sp-2);
    color: inherit;
  }

  .cta-banner__copy p {
    margin: 0;
    font-size: var(--fs-md);
    color: rgba(255, 255, 255, 0.82);
  }

  .cta-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  @media (max-width: 700px) {
    .cta-banner__inner {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }
    .cta-banner__actions {
      justify-content: center;
    }
  }
</style>
