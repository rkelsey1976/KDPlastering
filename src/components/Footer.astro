            </a>
          </li>
        </ul>
        <p class="footer-hours">Mon–Fri 8am–6pm · Sat 9am–1pm</p>
      </div>

      <details class="footer-col" open>
        <summary><h3>Services</h3><svg class="footer-col__chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
        <ul>
          {services.map((slug) => (
            <li><a href={`/our-services/${slug}-bristol/`}>{slug.split('-').map(w => w[0].toUpperCase() + w.slice(1)).join(' ')}</a></li>
          ))}
        </ul>
      </details>

      <details class="footer-col" open>
        <summary><h3>Service Areas</h3><svg class="footer-col__chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
        <p class="footer-area-note">
          Bristol — 15 neighbourhoods across BS postcodes. Bath — 5 neighbourhoods across BA postcodes. South Gloucestershire &amp; North Somerset by arrangement.
        </p>
        <p class="footer-area-note">
          Free site visits within 10 miles of BS15.
        </p>
      </details>

      <details class="footer-col" open>
        <summary><h3>Company</h3><svg class="footer-col__chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
        <ul>
          <li><a href="/our-services/">All Services</a></li>
          <li><a href="/about-us/">About Us</a></li>
          <li><a href="/our-work/">Gallery</a></li>
          <li><a href="/faqs/">FAQs</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/bristol/">Bristol Areas</a></li>
          <li><a href="/bath/">Bath Areas</a></li>
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms &amp; Conditions</a></li>
          <li><a href="/cookies/">Cookies</a></li>
        </ul>
      </details>
    </div>

    <div class="footer-accreditations">
      <span class="accred">✓ Checkatrade Approved</span>
      <span class="accred">✓ Johnstone's Systems</span>
      <span class="accred">✓ Parex Installer</span>
      <span class="accred">✓ BBA Approved Systems</span>
      <span class="accred">✓ Fully Insured £2m</span>
    </div>

    <div class="footer-bottom">
      <p>
        &copy; {year} KD Plastering &amp; Rendering Services.
        Trading name of K D Plastering Services Ltd, registered in England &amp; Wales.
      </p>
      {/* Canonical host is the apex — www redirects to it, so link the apex
          directly rather than through a 301. */}
      <p class="footer-credit">
        Website by <a href="https://seo-kings.co.uk/">SEO Kings</a>
      </p>
    </div>
  </div>
</footer>

<script is:inline>
  // The footer columns collapse only at one column. They ship open so the
  // page is correct on tablet/desktop and without JS; this closes them on
  // phones and re-syncs if the viewport crosses the breakpoint (rotation).
  (() => {
    const mq = window.matchMedia('(max-width: 600px)');
    const cols = document.querySelectorAll('details.footer-col');
    const sync = () => cols.forEach((d) => { d.open = !mq.matches; });

    // Only act when the breakpoint is actually crossed. A plain resize
    // handler would slam the panels shut every time a mobile browser's URL
    // bar changes the viewport height mid-scroll.
    let last = mq.matches;
    const check = () => {
      if (mq.matches === last) return;
      last = mq.matches;
      sync();
    };

    sync();
    mq.addEventListener('change', check);
    // Belt and braces: some embedded webviews resize without firing the
    // media-query change event.
    window.addEventListener('resize', check, { passive: true });
  })();
</script>

<style>
  .site-footer {
    background: var(--surface-inverse);
    color: var(--text-inverse-muted);
    padding: var(--sp-8) 0 var(--sp-5);
    /* No margin-top: the CTA band sits directly above and both are
       near-black, so they should read as one continuous block. */
  }
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--sp-5);
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr 1fr;
    gap: var(--sp-6);
  }
  .footer-brand {
    max-width: 280px;
  }
  .footer-logo {
    margin-bottom: var(--sp-4);
    color: var(--text-inverse);
  }
  .footer-tagline {
    font-size: var(--fs-sm);
    line-height: 1.6;
    margin: 0;
    color: rgba(255, 255, 255, 0.65);
  }
  /* Accordion behaviour is MOBILE ONLY. On desktop the <details> content is
     forced visible regardless of open state and the summary stops behaving
     like a control, so the footer looks and works exactly as it did. */
  .footer-col > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    cursor: pointer;
    list-style: none;
  }
  .footer-col > summary::-webkit-details-marker { display: none; }
  .footer-col > summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .footer-col > summary h3 { margin-bottom: 0; }
  .footer-col__chev {
    flex: none;
    color: var(--accent-on-dark);
    transition: transform var(--dur-fast) var(--ease);
  }
  details.footer-col[open] > summary .footer-col__chev { transform: rotate(180deg); }

  @media (min-width: 601px) {
    /* Above one column the summary stops being a control. The panels are
       held open by the script below rather than by CSS: a closed <details>
       gets content-visibility from the UA, so it measures zero height even
       when its children are display:block. */
    .footer-col > summary { cursor: default; pointer-events: none; }
    .footer-col__chev { display: none; }
  }

  .footer-col h3 {
    color: var(--text-inverse);
    font-size: var(--fs-sm);
    margin: 0 0 var(--sp-4);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .footer-address,
  .footer-wa-tag {
    font-size: var(--fs-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-on-dark);
  }
  .footer-hours,
  .footer-area-note {
    font-size: var(--fs-sm);
    line-height: 1.6;
    margin: 0 0 var(--sp-3);
    color: rgba(255, 255, 255, 0.65);
  }
  .footer-contact-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--sp-3);
  }
  .footer-contact-list li {
    margin: 0 0 var(--sp-2);
  }
  .footer-contact-list a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--text-inverse);
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: 500;
    transition: color 0.15s;
  }
  .footer-contact-list a:hover {
    color: var(--accent-text);
  }
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-col li {
    margin: 0 0 var(--sp-2);
  }
  .footer-col a {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    font-size: var(--fs-sm);
    transition: color 0.15s;
  }
  .footer-col a:hover {
    color: var(--text-inverse);
  }
  .footer-accreditations {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-5);
    justify-content: center;
    padding: var(--sp-5) 0;
    margin-top: var(--sp-7);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .accred {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--fs-sm);
    font-weight: 500;
  }
  .footer-bottom {
    text-align: center;
    margin-top: var(--sp-5);
    color: rgba(255, 255, 255, 0.5);
    font-size: var(--fs-xs);
  }
  .footer-bottom p { margin: 0; }
  .footer-credit { margin-top: var(--sp-2) !important; }
  .footer-credit a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--dur-fast) var(--ease);
  }
  .footer-credit a:hover { color: var(--accent-on-dark); }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 600px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 0;
    }
    /* Collapsed columns are just a row of headings — give them a divider so
       the footer reads as a list of sections rather than floating text. */
    details.footer-col {
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      padding-top: var(--sp-4);
    }
    .footer-col > summary { min-height: 44px; }
    .footer-brand { margin-bottom: var(--sp-5); }
    .footer-accreditations {
      gap: var(--sp-3);
      margin-top: var(--sp-5);
    }
    .accred { font-size: var(--fs-xs); }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-col__chev { transition: none; }
  }
</style>
