---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from './Hero.astro';
import ServiceBullets from './ServiceBullets.astro';
import ReviewCards from './ReviewCards.astro';
import ServiceCard from './ServiceCard.astro';
import AreaIndex from './AreaIndex.astro';
import MaterialGrid from './MaterialGrid.astro';
import CaseStudy from './CaseStudy.astro';
import AuthorityBio from './AuthorityBio.astro';
import { getArea, type Area } from '../lib/areas';
import { SERVICES } from '../lib/services';
import { REVIEWS } from '../lib/reviews';

// The neighbourhood hub, shared by /bristol/[slug] and /bath/[slug].
// Everything that differs between the two cities is derived from the
// area's own `city` field rather than duplicated into a second template.
type Props = { area: Area };
const { area } = Astro.props as Props;

const cityName = area.city === 'bath' ? 'Bath' : 'Bristol';
const citySlug = area.city;

// Bristol drills all the way to service × area; Bath stops at the city
// service page, which is as deep as that side of the site goes.
const serviceHref = (slug: string) =>
  area.city === 'bristol'
    ? `/our-services/${slug}-bristol/${area.slug}/`
    : `/our-services/${slug}-bath/`;

const serviceImages: Record<string, string> = {
  'silicone-rendering':       '/services/cards/silicone-rendering.webp',
  'house-rendering':          '/services/cards/house-rendering.webp',
  'external-wall-rendering':  '/services/cards/ewall-rendering.webp',
  'monocouche-rendering':     '/services/cards/monocouche-rendering.webp',
  'plastering-services':      '/services/cards/plastering.webp',
  'external-wall-insulation': '/services/cards/ewi.webp',
};

// Cross-links to neighbouring areas, resolved to real entries so a stale
// slug in the data can never render a dead link. Kept within one city:
// the data has Bath areas listing Bristol neighbours and vice versa.
const nearby = area.nearbyAreas
  .map((s: string) => getArea(s))
  .filter((a): a is NonNullable<typeof a> => Boolean(a) && a!.city === area.city);

// Reviews actually left in this area, where we have them. Nine of the
// twenty areas do; the rest fall back to city-wide, labelled honestly
// rather than implying a local review that does not exist.
// Systems are the same wherever we work, so this is the service pages'
// own material list rather than a second copy of it. De-duped across the
// six services, which all specify from the same handful of manufacturers.
const materials = Array.from(
  new Map(SERVICES.flatMap((sv) => sv.materials).map((m) => [m.manufacturer, m])).values()
);

// A real case study belongs to one area. Show it on that area's page.
const caseStudy = SERVICES.find((sv) => sv.caseStudy.location === area.slug)?.caseStudy ?? null;

const localReviews = REVIEWS.filter((r) => r.area === area.name);
const reviews = localReviews.length ? localReviews : REVIEWS.slice(0, 3);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Plastering and rendering',
  provider: {
    '@type': 'LocalBusiness',
    '@id': 'https://www.kdplasteringrenderingservices.co.uk/#organization',
    name: 'KD Plastering & Rendering Services',
    telephone: '+441174094116',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '8 Roman Way, Hanham',
      addressLocality: 'Bristol',
      postalCode: 'BS15 3FH',
      addressCountry: 'GB',
    },
  },
  areaServed: {
    '@type': 'Place',
    name: `${area.name}, ${cityName}`,
    address: { '@type': 'PostalAddress', addressLocality: area.name, postalCode: area.postcode, addressCountry: 'GB' },
  },
  description: area.metaDescription,
};
---

<PageLayout
  title={area.titleTemplate}
  description={area.metaDescription}
  preloadImage="/heroes/our-services.webp"
  canonical={`/${citySlug}/${area.slug}/`}
  schema={schema}
  breadcrumbs={[
    { name: cityName, href: `/${citySlug}/` },
    { name: area.name, href: `/${citySlug}/${area.slug}/` },
  ]}
  ctaHeading={`Rendering a property in ${area.name}?`}
  ctaText={`Free site visit across ${area.name} and the rest of ${cityName}, a fixed written quote within 48 hours, and no pressure either way.`}
>
  <Hero
    size="compact"
    eyebrow={[`${area.name} · ${area.postcode}`, area.type]}
    title="Plastering & rendering in"
    titleAccent={area.name}
    lede={area.intro}
    primaryCta={{ label: 'Get a Free Quote', href: '/contact/#lead-form-heading' }}
    phone={{ number: '+441174094116', display: '0117 409 4116' }}
    image="/heroes/our-services.webp"
    imageAlt=""
    trust={['Free site visit', 'Fixed written quote', '10-year warranty']}
  />

  <!-- Local context -->
  <section class="section">
    <div class="container">
      <div class="media-split">
        <div class="media-split__copy">
          <p class="area-lead">{area.longIntro}</p>
        </div>
        <figure class="media-split__media">
          <img
            src="/services/gallery/monocouche-rendering-2.webp"
            alt="Traditional detached house finished in cream monocouche render"
            width="920" height="613" loading="lazy" decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- Housing stock -->
  <section class="section section--alt">
    <div class="container">
      <ServiceBullets
        items={area.propertyTypes}
        variant="do"
        columns={3}
        eyebrow="Housing stock"
        heading={`Property types we render in ${area.name}`}
        lede="What we typically work on here, and what it means for the render specification."
      />
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Services</span>
        <h2>What we do in {area.name}</h2>
        <p class="lede">Every service is available across {area.postcode} and the surrounding streets.</p>
      </header>
      <div class="service-grid-3">
        {SERVICES.map((svc, i) => (
          <ServiceCard
            slug={svc.slug}
            shortName={`${svc.shortName.replace(/\s+Services$/i, '')} in ${area.name}`}
            tagline={svc.tagline}
            imageSrc={serviceImages[svc.slug]}
            number={String(i + 1).padStart(2, '0')}
            variant="default"
            href={serviceHref(svc.slug)}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Local knowledge -->
  <section class="section section--alt">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Local knowledge</span>
        <h2>Working in {area.name}</h2>
      </header>

      <div class="area-facts">
        <div class="area-fact">
          <h3>Recent work nearby</h3>
          <ul class="area-fact__list">
            {area.nearbyProjects.map((p: string) => <li>{p}</li>)}
          </ul>
        </div>
        <div class="area-fact">
          <h3>Landmarks we work around</h3>
          <ul class="area-fact__chips">
            {area.landmarks.map((l: string) => <li>{l}</li>)}
          </ul>
        </div>
        <div class="area-fact">
          <h3>Access &amp; parking</h3>
          <p>{area.transport}</p>
        </div>
        <div class="area-fact">
          <h3>Pricing notes</h3>
          <p>{area.costVariation}</p>
        </div>
        <div class="area-fact">
          <h3>Who lives here</h3>
          <p>{area.demographics}</p>
        </div>
      </div>
    </div>
  </section>
  {/* From here down the page runs in the same order as a service page:
      systems, a real project, reviews, the installer. Same components,
      so a neighbourhood page and a service page feel like one site. */}
  <section class="section">
    <div class="container">
      <MaterialGrid
        materials={materials}
        eyebrow="Systems"
        heading={`Render systems we fit in ${area.name}`}
        lede="The same manufacturer-approved systems we specify across every job, whichever service you need."
      />
    </div>
  </section>

  {caseStudy && (
    <section class="section section--alt">
      <div class="container">
        <CaseStudy caseStudy={caseStudy} areaName={area.name} />
      </div>
    </section>
  )}

  <ReviewCards
    reviews={reviews}
    eyebrow="Reviews"
    heading={localReviews.length ? `What ${area.name} customers say` : `What ${cityName} homeowners say`}
    lede={localReviews.length
      ? `Verified reviews from work completed in ${area.name}.`
      : 'Verified reviews from recent work across Bristol and Bath.'}
  />

  <!-- Nearby areas -->
  <section class="section">
    <div class="container">
      <AuthorityBio
        compact={true}
        name="Kyran"
        role="Founder & Lead Installer"
        qualifications={[
          'NVQ Level 3 in Plastering',
          "Johnstone's Stormshield Registered Installer",
          'Parex Approved Applicator',
          'Weber EWI Certified Installer',
        ]}
        bio={`Kyran has been rendering and plastering across Bristol and Bath since 2014, and works on ${area.name} properties himself rather than subcontracting them out.`}
      />
    </div>
  </section>

  {nearby.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <header class="section-header section-header--center">
          <span class="eyebrow">Nearby</span>
          <h2>We also cover</h2>
        </header>
        <AreaIndex areas={nearby} city={citySlug} />
      </div>
    </section>
  )}
</PageLayout>

<style>
  .area-lead { font-size: var(--fs-md); line-height: 1.75; color: var(--text-secondary); }

  .area-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--sp-4);
  }
  .area-fact {
    padding: var(--sp-5);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .area-fact h3 {
    margin: 0 0 var(--sp-3);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--text-muted);
  }
  .area-fact p { margin: 0; font-size: var(--fs-sm); line-height: 1.6; color: var(--text-secondary); }

  .area-fact__list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: var(--sp-3); }
  .area-fact__list li {
    position: relative;
    padding-left: var(--sp-4);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--text-secondary);
  }
  .area-fact__list li::before {
    content: '';
    position: absolute;
    left: 0; top: 0.55em;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .area-fact__chips { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .area-fact__chips li {
    padding: var(--sp-1) var(--sp-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: var(--fs-xs);
    color: var(--text-secondary);
  }
</style>
