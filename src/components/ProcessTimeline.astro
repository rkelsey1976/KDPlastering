---
// ProcessTimeline — premium vertical timeline with numbered circles
// connected by a gradient line. Each step has icon + title + duration
// + description. Designed to feel like a real project timeline.

type Step = {
  title: string;
  description: string;
};

type Props = {
  steps: Step[];
  heading?: string;
  lede?: string;
};

const { steps, heading, lede } = Astro.props as Props;

// Process icon per step (uses a focused set of workflow icons)
const stepIcons = [
  'phone',     // 1. Site visit
  'document',  // 2. Quote
  'scaffold',  // 3. Setup
  'hammer',    // 4. Prep
  'ruler',     // 5. Beading
  'paint',     // 6. Base coat
  'paint2',    // 7. Top coat
  'check',     // 8. Snag
  'shield',    // 9. Warranty
  'calendar',  // 10. Aftercare
];

const iconPaths: Record<string, string> = {
  phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
  document: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/>',
  scaffold: '<rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/>',
  hammer: '<path d="M14 6l-7.4 7.4a2 2 0 0 0 0 2.8l1.2 1.2a2 2 0 0 0 2.8 0L18 9.8V6h-4z"/>',
  ruler: '<path d="M21.3 8.7L15.3 2.7a1 1 0 0 0-1.4 0L2.7 13.9a1 1 0 0 0 0 1.4l6 6a1 1 0 0 0 1.4 0L21.3 10.1a1 1 0 0 0 0-1.4z"/>',
  paint: '<path d="M19 11h2v8h-2zM9 2v8H7V2h2zm0 0V0h2v2H9zm12 0V0h2v2h-2zM2 9h8v2H2V9zm0 0V7h2v2H2zm6-7v8H6V2h2zm0 0V0h2v2H8z"/>',
  paint2: '<path d="M19 11h2v8h-2zM9 2v8H7V2h2zm0 0V0h2v2H9zm12 0V0h2v2h-2zM2 9h8v2H2V9zm0 0V7h2v2H2zm6-7v8H6V2h2zm0 0V0h2v2H8z"/>',
  check: '<circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
};
---

{heading && (
  <header class="process-header">
    <h2>{heading}</h2>
    {lede && <p class="lede">{lede}</p>}
  </header>
)}

<ol class="process-timeline">
  {steps.map((step, i) => {
    const iconName = stepIcons[i] ?? stepIcons[i % stepIcons.length];
    const path = iconPaths[iconName] ?? iconPaths.check;
    return (
      <li class="process-step">
        <div class="process-step__marker">
          <span class="process-step__num">{String(i + 1).padStart(2, '0')}</span>
          <div class="process-step__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={path} />
          </div>
        </div>
        <div class="process-step__body">
          <h3 class="process-step__title">{step.title}</h3>
          <p class="process-step__desc">{step.description}</p>
        </div>
      </li>
    );
  })}
</ol>

<style>
  .process-header {
    margin-bottom: var(--sp-7);
    text-align: center;
    max-width: 60ch;
    margin-left: auto;
    margin-right: auto;
  }
  .process-header .lede {
    margin-left: auto;
    margin-right: auto;
  }

  /* Timeline */
  .process-timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Connecting line */
  .process-timeline::before {
    content: '';
    position: absolute;
    left: 40px;
    top: 32px;
    bottom: 32px;
    width: 2px;
    background: linear-gradient(180deg,
      transparent 0%,
      var(--color-clay) 8%,
      var(--color-clay) 92%,
      transparent 100%);
    opacity: 0.3;
  }

  .process-step {
    display: flex;
    gap: var(--sp-5);
    padding: var(--sp-4) 0 var(--sp-6);
    margin: 0;
    position: relative;
  }

  /* Marker column: number + icon circle */
  .process-step__marker {
    flex-shrink: 0;
    width: 80px;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .process-step__num {
    position: absolute;
    top: -8px;
    right: -8px;
    font-size: var(--fs-xs);
    font-weight: 800;
    color: var(--color-clay);
    background: var(--color-cream);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    font-feature-settings: 'tnum';
  }

  .process-step__icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--color-clay);
    color: var(--color-clay-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-sm);
    z-index: 1;
    position: relative;
  }

  /* Body */
  .process-step__body {
    flex-grow: 1;
    padding-top: var(--sp-1);
  }

  .process-step__title {
    margin: 0 0 var(--sp-2);
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--color-walnut);
    letter-spacing: -0.01em;
  }

  .process-step__desc {
    margin: 0;
    font-size: var(--fs-base);
    line-height: 1.6;
    color: var(--color-walnut-muted);
  }

  @media (max-width: 560px) {
    .process-step {
      gap: var(--sp-3);
    }
    .process-step__marker {
      width: 56px;
    }
    .process-step__icon {
      width: 44px;
      height: 44px;
    }
    .process-step__num {
      font-size: 10px;
    }
  }
</style>