---
// AuthorityBio — founder / team bio block with avatar placeholder,
// name, qualifications, signed byline. For E-E-A-T.

type Props = {
  name: string;
  role: string;
  qualifications: string[];
  bio: string;
  signed?: boolean;
};

const { name, role, qualifications, bio, signed = true } = Astro.props as Props;
---

<aside class="authority-bio" aria-label={`About ${name}`}>
  <div class="authority-avatar" aria-hidden="true">
    <span class="authority-initial">{name.split(' ').map(n => n[0]).join('')}</span>
  </div>
  <div class="authority-content">
    <p class="authority-role">{role}</p>
    <h3 class="authority-name">{name}</h3>
    <p class="authority-bio">{bio}</p>
    {qualifications.length > 0 && (
      <ul class="authority-qualifications">
        {qualifications.map((q) => <li>{q}</li>)}
      </ul>
    )}
    {signed && (
      <p class="authority-signed">— {name}, {role}, KD Plastering &amp; Rendering Services</p>
    )}
  </div>
</aside>

<style>
  .authority-bio {
    display: flex;
    gap: 1.5rem;
    background: #fff;
    border: 1px solid var(--color-stone-deep);
    border-radius: 8px;
    padding: 1.5rem;
    margin: 2rem 0;
  }
  .authority-avatar {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-slate) 0%, var(--color-slate-deep) 100%);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    font-weight: 700;
  }
  .authority-initial {
    line-height: 1;
  }
  .authority-content {
    flex: 1;
  }
  .authority-role {
    margin: 0 0 0.25rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-ink-muted);
    font-weight: 600;
  }
  .authority-name {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
    color: var(--color-ink);
  }
  .authority-bio {
    margin: 0 0 0.75rem;
    color: #2c2c2c;
    line-height: 1.6;
  }
  .authority-qualifications {
    list-style: none;
    padding: 0;
    margin: 0 0 0.75rem;
  }
  .authority-qualifications li {
    background: var(--color-slate-light);
    border-left: 3px solid var(--color-slate);
    padding: 0.4rem 0.75rem;
    margin: 0.3rem 0;
    font-size: 0.85rem;
    color: #2c2c2c;
  }
  .authority-signed {
    margin: 0.75rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid #e6e6e6;
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    font-style: italic;
  }
  @media (max-width: 600px) {
    .authority-bio {
      flex-direction: column;
      text-align: center;
    }
    .authority-avatar {
      margin: 0 auto;
    }
  }
</style>
